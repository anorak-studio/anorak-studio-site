---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; image?: string; }
const { title, description = site.description, image = site.heroImage } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Preload every custom cursor image. Without this, the very first hover/press that needs
        a given cursor (e.g. the hand on the homepage carousel) can show the browser's own
        fallback cursor (an arrow, a pointing hand) for a beat while that PNG downloads — only
        switching to our art once it finishes loading. Preloading gets them all into cache
        before any interaction is possible, so it's always ours, never the system one. */}
    {['arrow', 'point', 'peace', 'text', 'perfect', 'hand', 'grabbing', 'heart', 'click', 'fck'].map((name) => (
      <link rel="preload" as="image" href={`/cursors/${name}.png`} />
    ))}
    <script is:inline>
      // Always start a newly-loaded page at the top (some browsers/embeds restore the
      // previous page's scroll position on navigation, which looks like a broken link).
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
    </script>
    <meta name="theme-color" content="#111814" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800&family=Inter:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <script is:inline>
      // Custom CSS cursors are only repainted on an actual pointer event, so every full
      // page navigation (e.g. clicking the ANORAK logo back to "/") starts a beat with the
      // browser's own system arrow until the mouse next moves, however tiny that move is.
      // We remember the last pointer position across navigations (sessionStorage survives
      // a real page load, unlike JS state) and replay it as a synthetic pointer move the
      // instant this page can respond, so it's our own arrow from the very first frame —
      // no waiting on the visitor to actually move the mouse.
      (function () {
        var KEY = 'anorak:cursorPos';
        var raf = null;
        addEventListener('pointermove', function (e) {
          if (e.pointerType !== 'mouse' || raf) return;
          raf = requestAnimationFrame(function () {
            raf = null;
            try { sessionStorage.setItem(KEY, e.clientX + ',' + e.clientY); } catch (err) {}
          });
        }, { passive: true });

        var saved;
        try { saved = sessionStorage.getItem(KEY); } catch (err) {}
        if (!saved) return;
        var parts = saved.split(',');
        var x = Number(parts[0]), y = Number(parts[1]);
        if (!isFinite(x) || !isFinite(y)) return;

        var replay = function () {
          var el = document.elementFromPoint(x, y) || document.body;
          el.dispatchEvent(new PointerEvent('pointermove', { clientX: x, clientY: y, bubbles: true, cancelable: true }));
        };
        replay();
        addEventListener('DOMContentLoaded', replay);
        addEventListener('load', replay);
      })();
    </script>
    <Header />
    <main><slot /></main>
    <Footer />
    <script>
      // Parallax hero media: the media inside [data-parallax] is rendered oversized
      // (see Media.astro / Img.astro's `parallax` prop) so it can shift a little without
      // ever revealing an edge. `target` is a pure function of the element's current
      // position relative to the viewport centre — never an accumulated delta — so it
      // can't drift or end up somewhere wrong. What's applied each frame is `current`,
      // eased a little further toward `target` every frame (current += (target-current)*factor):
      // while scrolling this tracks the target closely, and once scrolling stops it keeps
      // gliding those last few pixels for a couple hundred ms so the movement is easy to
      // actually see, instead of stopping the instant the page does.
      // data-parallax-speed sets each section's normal (desktop) intensity; it's scaled
      // down further on narrow/mobile viewports, and to zero under prefers-reduced-motion,
      // which leaves the media visible in its normal, centred crop with no motion at all.
      (() => {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
        if (!els.length) return;

        const targets = els
          .map((el) => ({
            el,
            media: el.querySelector<HTMLElement>('.parallax__media'),
            base: parseFloat(el.dataset.parallaxSpeed || '0.15'),
            current: 0,
            target: 0,
          }))
          .filter((t): t is { el: HTMLElement; media: HTMLElement; base: number; current: number; target: number } => !!t.media);
        if (!targets.length) return;

        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
        if (reduceMotion.matches) return; // media stays put in its default centred crop
        const narrow = matchMedia('(max-width: 700px)');
        const settleFactor = 0.09; // higher = snappier/shorter settle, lower = slower/longer

        const computeTargets = () => {
          const vh = window.innerHeight;
          const scale = narrow.matches ? 0.55 : 1; // gentler, still-stable version on small screens
          for (const t of targets) {
            const rect = t.el.getBoundingClientRect();
            if (rect.bottom < -200 || rect.top > vh + 200) continue; // well off-screen: leave as-is
            const center = rect.top + rect.height / 2 - vh / 2;
            const max = rect.height * 0.18; // stays inside the 20%-oversized media (see Media.astro/Img.astro)
            t.target = Math.max(-max, Math.min(max, center * t.base * scale));
          }
        };

        let ticking = false;
        const loop = () => {
          computeTargets();
          let stillMoving = false;
          for (const t of targets) {
            t.current += (t.target - t.current) * settleFactor;
            if (Math.abs(t.target - t.current) > 0.05) stillMoving = true;
            else t.current = t.target;
            t.media.style.transform = `translate3d(0, ${t.current.toFixed(2)}px, 0)`;
          }
          // Keep the loop running a little past the last scroll/resize event so the ease-out
          // is actually visible, then stop (no point burning frames once everything's settled).
          if (stillMoving) requestAnimationFrame(loop);
          else ticking = false;
        };
        const kick = () => { if (!ticking) { ticking = true; requestAnimationFrame(loop); } };
        addEventListener('scroll', kick, { passive: true });
        addEventListener('resize', kick, { passive: true });
        computeTargets();
        for (const t of targets) t.current = t.target;
        kick();
      })();

      // Project-card reveal: cards fade up the first time they enter the viewport, then
      // stay put — they never replay on the way back up. Progressive enhancement: cards
      // are only hidden once we know IntersectionObserver can reveal them again, so a
      // browser without it (or reduced-motion) simply shows every card, fully visible,
      // from the start.
      (() => {
        const cards = Array.from(document.querySelectorAll<HTMLElement>('.pitem, .tile'));
        if (!cards.length || !('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        cards.forEach((c) => { c.style.opacity = '0'; c.style.transform = 'translateY(10px)'; });

        const io = new IntersectionObserver((entries) => {
          const visible = entries.filter((e) => e.isIntersecting);
          if (!visible.length) return;
          visible
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top || a.boundingClientRect.left - b.boundingClientRect.left)
            .forEach((entry, i) => {
              const el = entry.target as HTMLElement;
              el.style.transitionDelay = `${Math.min(i, 11) * 45}ms`;
              requestAnimationFrame(() => {
                el.style.opacity = '1';
                el.style.transform = 'translateY(0)';
              });
              io.unobserve(el);
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });

        cards.forEach((c) => io.observe(c));
      })();
    </script>
  </body>
</html>
