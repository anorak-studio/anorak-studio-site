---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; image?: string; }
const { title, description = site.description, image = site.heroImage } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Always start a newly-loaded page at the top (some browsers/embeds restore the
      // previous page's scroll position on navigation, which looks like a broken link).
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
    </script>
    <meta name="theme-color" content="#111814" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800&family=Inter:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script>
      // Parallax hero media: the media inside [data-parallax] is rendered oversized
      // (see Media.astro / Img.astro's `parallax` prop) so it can shift a little without
      // ever revealing an edge. The offset is a pure function of the element's current
      // position relative to the viewport centre — never an accumulated delta — so it
      // can't drift, jump, or lag behind native scrolling; it just tracks it exactly.
      // data-parallax-speed sets each section's normal (desktop) intensity; it's scaled
      // down further on narrow/mobile viewports, and to zero under prefers-reduced-motion,
      // which leaves the media visible in its normal, centred crop with no motion at all.
      (() => {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
        if (!els.length) return;

        const targets = els
          .map((el) => ({ el, media: el.querySelector<HTMLElement>('.parallax__media'), base: parseFloat(el.dataset.parallaxSpeed || '0.15') }))
          .filter((t): t is { el: HTMLElement; media: HTMLElement; base: number } => !!t.media);
        if (!targets.length) return;

        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
        const narrow = matchMedia('(max-width: 700px)');

        let queued = false;
        const update = () => {
          queued = false;
          if (reduceMotion.matches) return; // media stays put in its default centred crop
          const vh = window.innerHeight;
          const scale = narrow.matches ? 0.55 : 1; // gentler, still-stable version on small screens
          for (const { el, media, base } of targets) {
            const rect = el.getBoundingClientRect();
            if (rect.bottom < -200 || rect.top > vh + 200) continue; // well off-screen: skip
            const center = rect.top + rect.height / 2 - vh / 2;
            const max = rect.height * 0.18; // stays inside the 20%-oversized media (see Media.astro/Img.astro)
            const offset = Math.max(-max, Math.min(max, center * base * scale));
            media.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
          }
        };
        const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        update();
      })();

      // Project-card reveal: cards fade up the first time they enter the viewport, then
      // stay put — they never replay on the way back up. Progressive enhancement: cards
      // are only hidden once we know IntersectionObserver can reveal them again, so a
      // browser without it (or reduced-motion) simply shows every card, fully visible,
      // from the start.
      (() => {
        const cards = Array.from(document.querySelectorAll<HTMLElement>('.pitem, .tile'));
        if (!cards.length || !('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        cards.forEach((c) => { c.style.opacity = '0'; c.style.transform = 'translateY(10px)'; });

        const io = new IntersectionObserver((entries) => {
          const visible = entries.filter((e) => e.isIntersecting);
          if (!visible.length) return;
          visible
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top || a.boundingClientRect.left - b.boundingClientRect.left)
            .forEach((entry, i) => {
              const el = entry.target as HTMLElement;
              el.style.transitionDelay = `${Math.min(i, 11) * 45}ms`;
              requestAnimationFrame(() => {
                el.style.opacity = '1';
                el.style.transform = 'translateY(0)';
              });
              io.unobserve(el);
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });

        cards.forEach((c) => io.observe(c));
      })();
    </script>
  </body>
</html>
