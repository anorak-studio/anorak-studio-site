---
// Shop placeholder. Plan (docs/boutique-plan.md): Printify -> Shopify, products shown here
// (Wooders sweaters, the Unikaangit book), multi-currency and bilingual.
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { boutique } from '../data/site';
---
<Base title="Boutique" description={boutique.text}>
  <PageTitle title="Boutique" />
  <section class="section wrap center boutique-page">
    <p class="big">Bientôt.</p>
    <p class="muted">
      Les gilets et vêtements <a href={boutique.href} target="_blank" rel="noopener">Wooders</a>, et le livre
      <a href="/projets/unikaangit-legendes-inuites/">Unikaangit, Légendes inuites</a>, seront bientôt en vente ici.
    </p>
    <p class="btns">
      <a class="btn" href={boutique.href} target="_blank" rel="noopener">Visiter wooders.ca</a>
      <a class="btn btn--ghost" href="/contact/">Être avisé à l'ouverture</a>
    </p>
  </section>
</Base>

<style>
  .boutique-page, .boutique-page * { cursor: var(--cursor-heart); }
  .big { font: 800 clamp(2rem, 5vw, 3rem)/1 var(--f-display); color: var(--c-brand); }
  .muted { color: var(--c-muted); max-width: 56ch; margin: 0 auto 2rem; }
  .muted a { color: var(--c-brand); }
  .btns { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; }
  .btn--ghost { background: transparent; color: var(--c-ink); box-shadow: inset 0 0 0 1.5px currentColor; }
  .btn--ghost:hover { background: var(--c-ink); color: var(--c-bg); }
</style>
