---
// Wooders shop, live from Shopify's Storefront API (see src/lib/shopify.ts for how and why).
// Buying takes visitors to the product's Shopify-hosted page for checkout — no cart built
// here yet, see docs/boutique-plan.md for the fuller plan.
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { site, boutique } from '../data/site';
import { getShopProducts, formatPrice } from '../lib/shopify';

// site.showBoutique is off for now (see src/data/site.ts) — skip the Shopify call
// entirely and fall back to the old "Bientôt" placeholder below. Flip that flag back on
// when we're ready to sell; nothing else here needs to change.
const products = site.showBoutique ? await getShopProducts() : [];
---
<Base title="Boutique" description={boutique.text}>
  <PageTitle title="Boutique" />

  {products.length > 0 ? (
    <section class="section wrap">
      <p class="intro">{boutique.text}</p>
      <div class="grid">
        {products.map((p) => (
          <a class:list={['card', { 'card--soldout': !p.available }]} href={p.url} target="_blank" rel="noopener">
            <div class="card__img">
              {p.image
                ? <img src={p.image.url} alt={p.image.alt} loading="lazy" decoding="async" />
                : <div class="card__img--missing" aria-hidden="true" />}
              {!p.available && <span class="card__badge">Épuisé</span>}
            </div>
            <p class="card__title">{p.title}</p>
            <p class="card__price">{formatPrice(p)}</p>
          </a>
        ))}
      </div>
      <p class="muted center">
        Le livre <a href="/projets/unikaangit-legendes-inuites/">Unikaangit, Légendes inuites</a> aussi bientôt ici —
        en attendant, écrivez-nous.
      </p>
    </section>
  ) : (
    <section class="section wrap center boutique-page">
      <p class="big">Bientôt.</p>
      <p class="muted">
        Les gilets et vêtements <a href={boutique.href} target="_blank" rel="noopener">Wooders</a>, et le livre
        <a href="/projets/unikaangit-legendes-inuites/">Unikaangit, Légendes inuites</a>, seront bientôt en vente ici.
      </p>
      <p class="btns">
        <a class="btn" href={boutique.href} target="_blank" rel="noopener">Visiter wooders.ca</a>
        <a class="btn btn--ghost" href="/contact/">Être avisé à l'ouverture</a>
      </p>
    </section>
  )}
</Base>

<style>
  .boutique-page, .boutique-page * { cursor: var(--cursor-heart); }
  .big { font: 800 clamp(2rem, 5vw, 3rem)/1 var(--f-display); color: var(--c-brand); }
  .muted { color: var(--c-muted); max-width: 56ch; margin: 0 auto 2rem; }
  .muted a { color: var(--c-brand); }
  .btns { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; }
  .btn--ghost { background: transparent; color: var(--c-ink); box-shadow: inset 0 0 0 1.5px currentColor; }
  .btn--ghost:hover { background: var(--c-ink); color: var(--c-bg); }

  .intro { max-width: 640px; margin: 0 auto clamp(32px, 5vw, 56px); text-align: center; color: var(--c-muted); font-size: 1.08rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: clamp(20px, 3vw, 32px); }
  .card { display: block; text-decoration: none; color: inherit; cursor: var(--cursor-perfect); }
  .card__img { position: relative; aspect-ratio: 1 / 1; border-radius: var(--radius); overflow: hidden; background: var(--c-grey); margin-bottom: .8rem; transition: transform .25s; }
  .card__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card__img--missing { position: absolute; inset: 0; }
  .card:hover .card__img { transform: translateY(-3px); }
  .card--soldout .card__img { opacity: .55; }
  .card__badge {
    position: absolute; top: 10px; right: 10px; background: var(--c-ink); color: var(--c-bg);
    font: 700 .72rem/1 var(--f-body); padding: .4em .7em; border-radius: 999px; letter-spacing: .03em;
  }
  .card__title { font: 700 1rem/1.3 var(--f-display); margin-bottom: .2em; }
  .card__price { color: var(--c-brand); font-weight: 600; }
  .center { text-align: center; }
</style>
