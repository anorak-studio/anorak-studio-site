---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.city} ${site.address.postal}`);
---
<Base title="Contact" description={site.about}>
  <section class="section">
    <div class="wrap cols">
      <div>
        <span class="eyebrow">Contact</span>
        <h1>Parlons-en.</h1>
        <p class="lead">{site.about}</p>
        <dl>
          <dt>Courriel</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          <dt>Direct</dt><dd><a href={`mailto:${site.emailDirect}`}>{site.emailDirect}</a></dd>
          <dt>Téléphone</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd>
          <dt>Adresse</dt>
          <dd>
            <a href={`https://maps.google.com/?q=${mapQuery}`} target="_blank" rel="noopener">
              {site.address.street}, {site.address.city}<br />{site.address.country}, {site.address.postal}
            </a>
          </dd>
        </dl>
      </div>

      <form class="form" method="POST" action={site.formEndpoint || `mailto:${site.email}`} enctype={site.formEndpoint ? undefined : 'text/plain'}>
        <label>Nom<input name="nom" required autocomplete="name" /></label>
        <label>Courriel<input name="courriel" type="email" required autocomplete="email" /></label>
        <label>Entreprise<input name="entreprise" autocomplete="organization" /></label>
        <label>Votre projet<textarea name="message" rows="6" required></textarea></label>
        <button class="btn" type="submit">Soumettre</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); }
  h1 { color: var(--c-brand); }
  dl { display: grid; grid-template-columns: auto 1fr; gap: .75rem 1.5rem; margin-top: 2rem; }
  dt { color: var(--c-muted); }
  dd { margin: 0; }
  dd a { text-decoration: none; }
  dd a:hover { text-decoration: underline; }
  .form { display: grid; gap: 1.1rem; background: var(--c-surface); padding: clamp(20px, 4vw, 40px); border-radius: var(--radius); border: 1px solid var(--c-line); align-self: start; }
  label { display: grid; gap: .35rem; font-weight: 500; font-size: .95rem; }
  input, textarea { font: inherit; padding: .75em .9em; border: 1px solid var(--c-line); border-radius: var(--radius); background: var(--c-bg); color: var(--c-ink); width: 100%; }
  input:focus, textarea:focus { outline: 2px solid var(--c-brand); outline-offset: 0; }
  .form .btn { justify-self: start; }
  @media (max-width: 800px) { .cols { grid-template-columns: 1fr; } }
</style>
