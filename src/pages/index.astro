---
// Same order as the old home page: landscape photo with the tagline, intro row
// (big logo + text + contact), carousel on the grey band, then the project grid.
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Social from '../components/Social.astro';
import logoStudio from '../assets/logos/anorak-studio.svg?raw';
import { site, carousel } from '../data/site';
import { getProjets } from '../lib/projets';

const projets = await getProjets();
---
<Base>
  <section class="hero" style={`background-image:url('${site.heroImage}')`}>
    <p>{site.heroTitle}</p>
  </section>

  <section class="intro wrap">
    <div class="intro__logo" set:html={logoStudio} role="img" aria-label="Anorak Studio" />
    <div class="intro__txt">
      <p class="intro__tag">{site.tagline}</p>
      <p>{site.intro}</p>
      <p class="intro__contact">
        <a href={`mailto:${site.email}`}>{site.email}</a> / <a href={site.phoneHref}>{site.phone}</a>
      </p>
      <Social />
    </div>
  </section>

  <section class="band">
    <div class="wrap"><Carousel slides={carousel} /></div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="center projets-t">Projets</h2>
      <ProjectGrid projets={projets} initial={8} />
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: clamp(360px, 55vw, 616px); display: grid; place-items: center; text-align: center;
    background-size: cover; background-position: center; position: relative; padding: 24px var(--gutter);
  }
  .hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 40%, color-mix(in srgb, var(--c-dark) 45%, transparent)); }
  .hero p { position: relative; margin: 0; color: #fff; font: 700 clamp(1.8rem, 4.2vw, 3.2rem)/1.1 var(--f-display); text-shadow: 0 2px 24px rgba(0, 0, 0, .45); }

  .intro { display: grid; grid-template-columns: 42% 1fr; gap: clamp(28px, 7vw, 100px); align-items: center; padding-block: 50px; }
  .intro__logo { color: var(--c-brand); max-width: 420px; justify-self: center; width: 100%; }
  .intro__logo :global(svg) { width: 100%; height: auto; display: block; }
  .intro__tag { font: 700 clamp(1.4rem, 2.6vw, 1.75rem)/1.2 var(--f-display); margin-bottom: .6em; }
  .intro__txt p { font-size: .98rem; color: var(--c-muted); }
  .intro__txt .intro__tag { color: var(--c-ink); }
  .intro__contact a { text-decoration: none; color: var(--c-ink); font-weight: 500; }
  .intro__contact a:hover { color: var(--c-brand); }
  .intro :global(.social) { margin-left: -8px; }

  .band { background: var(--c-grey); padding-block: clamp(28px, 5vw, 50px); }
  .projets-t { margin-bottom: 1.2em; }

  @media (max-width: 760px) {
    .intro { grid-template-columns: 1fr; text-align: center; padding-block: 36px; }
    .intro__logo { max-width: 260px; }
    .intro :global(.social) { justify-content: center; margin-left: 0; }
  }
</style>
