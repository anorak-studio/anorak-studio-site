---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Carousel from '../components/Carousel.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProjectTiles from '../components/ProjectTiles.astro';
import Featured from '../components/Featured.astro';
import Social from '../components/Social.astro';
import logoStudio from '../assets/logos/anorak-studio.svg?raw';
import { site, services, realisation, gamification, boutique, carousel, recents } from '../data/site';
import { getProjets, pickProjets } from '../lib/projets';

const projets = await getProjets();
const recentProjets = await pickProjets(recents.projects);
const films = await pickProjets(realisation.projects);
const jeux = await pickProjets(gamification.projects);
const taglineWords = site.tagline.split(' ');
---
<Base>
  <Hero />

  <section class="intro">
    <div class="intro__logo" set:html={logoStudio} role="img" aria-label="Anorak Studio" />
    <div class="wrap wrap--text intro__cols">
      <p class="intro__tag">
        {taglineWords.map((w, i) => <>{w}{i < taglineWords.length - 1 && <br />}</>)}
      </p>
      <div class="intro__txt">
        {site.intro.map((p) => <p>{p}</p>)}
        <p class="intro__contact">
          <a href="/contact/">Nous contacter →</a>
        </p>
        <Social />
      </div>
    </div>
  </section>

  {carousel.length > 0 && <Carousel slides={carousel} />}

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>{recents.title}</h2>
        <a class="link" href="/projets/">Tous les projets →</a>
      </div>
      <ProjectGrid projets={recentProjets} />
    </div>
  </section>

  <section class="statement">
    <div class="wrap">
      <p class="statement__t">{site.statement.title}</p>
      <p class="statement__p">{site.statement.text}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap--text">
      <div class="head">
        <h2>Services</h2>
        <a class="link" href="/services/">Tous les services →</a>
      </div>
      <ol class="svc">
        {services.map((s, i) => (
          <li>
            <a href={`/services/#${s.id}`}>
              <span class="svc__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc__t">{s.title}<small>{s.lead}</small></span>
              <span class="svc__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section ferns duo" data-parallax data-parallax-speed="0.3">
    <div class="ferns-bg parallax__media" aria-hidden="true"></div>
    <div class="wrap">
      <div class="duo__head">
        <span class="eyebrow">Courts métrages, séries et documentaires</span>
        <h2>{realisation.title}</h2>
        <p>{realisation.intro[0]}</p>
      </div>
      <Featured media={realisation.featured} caption={realisation.featuredCaption} />
      <ProjectTiles projets={films} dark cols={2} />
      <p class="duo__more"><a class="link link--light" href="/realisation/">En savoir plus sur la réalisation →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="duo__head">
        <span class="eyebrow">Jeux et expériences ludiques</span>
        <h2>{gamification.title}</h2>
        <p>{gamification.intro[0]}</p>
      </div>
      <Featured media={gamification.featured} caption={gamification.featuredCaption} />
      <ProjectTiles projets={jeux} cols={4} />
      <p class="duo__more"><a class="link" href="/gamification/">En savoir plus sur la gamification →</a></p>
    </div>
  </section>

  <section class="shop">
    <div class="wrap shop__in">
      <div>
        <span class="eyebrow">Boutique</span>
        <h2>{boutique.title}</h2>
        <p>{boutique.text}</p>
      </div>
      <div class="shop__cta">
        <a class="btn" href="/boutique/">La boutique</a>
        <a class="link" href={boutique.href} target="_blank" rel="noopener">wooders.ca →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>Projets</h2>
        <a class="link" href="/projets/">Tous les projets →</a>
      </div>
      <ProjectGrid projets={projets} initial={9} />
    </div>
  </section>
</Base>

<script>
  // Each ANORAK/studio letter fades out on hover. Once a fade starts it always finishes (the
  // class stays on even if the cursor leaves mid-transition), and the letter stays fully
  // vanished for a short hold after the cursor actually leaves before fading back in.
  const FADE_MS = 350; // matches the CSS transition duration
  const HOLD_MS = 1000;
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.intro__logo .alogo__word > *').forEach((el) => {
      let timer: ReturnType<typeof setTimeout> | undefined;
      el.addEventListener('mouseenter', () => {
        clearTimeout(timer);
        el.classList.add('is-vanished');
      });
      el.addEventListener('mouseleave', () => {
        clearTimeout(timer);
        timer = setTimeout(() => el.classList.remove('is-vanished'), FADE_MS + HOLD_MS);
      });
    });
  }
</script>

<style>
  /* Opaque so it fully covers the Hero's fixed background (z-index:-1) as it scrolls up over it. */
  .intro { position: relative; padding-block: clamp(48px, 7vw, 110px) clamp(40px, 6vw, 90px); background: var(--c-bg); }
  .intro__logo { color: var(--c-brand); width: min(1100px, 84vw); margin: 0 auto clamp(36px, 5vw, 72px); }
  .intro__logo :global(svg) { width: 100%; height: auto; display: block; }
  /* Each letter is its own group in the SVG (see src/assets/logos/anorak-studio.svg). Each
     letter reacts on its own: only the letter under the cursor fades out, independently of
     its neighbours — not the whole word at once. Driven by JS (.is-vanished, below) rather
     than :hover, so a fade that has started always finishes and holds briefly once the
     cursor leaves, instead of reversing immediately. */
  .intro__logo :global(.alogo__word > *) { transition: opacity .35s ease; cursor: default; }
  .intro__logo :global(.alogo__word > *.is-vanished) { opacity: 0; }
  .intro__cols { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(20px, 5vw, 80px); align-items: start; }
  .intro__tag { font: 800 clamp(1.6rem, 3vw, 2.4rem)/1.1 var(--f-display); margin: 0; }
  .intro__txt p { color: var(--c-muted); font-size: 1.08rem; }
  .intro__contact a { text-decoration: none; color: var(--c-ink); font-weight: 500; box-shadow: inset 0 -2px 0 transparent; transition: box-shadow .2s; }
  .intro__contact a:hover { box-shadow: inset 0 -2px 0 var(--c-neon); }
  .intro :global(.social) { margin-left: -8px; }

  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: clamp(20px, 3vw, 40px); }
  .head h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.2rem); }
  .link { color: var(--c-brand); font-weight: 600; text-decoration: none; box-shadow: inset 0 -2px 0 transparent; transition: box-shadow .2s, color .2s; }
  .link:hover { box-shadow: inset 0 -2px 0 var(--c-neon); }
  .link--light { color: #fff; }
  .link--light:hover { color: var(--c-neon); }

  .statement { background: var(--c-brand); color: var(--c-brand-ink); padding-block: clamp(72px, 11vw, 170px); }
  .statement__t { font: 800 clamp(2.2rem, 6vw, 5.2rem)/1.02 var(--f-display); max-width: 17ch; margin-bottom: .55em; letter-spacing: -0.02em; }
  .statement__p { font-size: clamp(1.1rem, 2vw, 1.4rem); max-width: 52ch; color: color-mix(in srgb, var(--c-brand-ink) 82%, transparent); margin: 0; }

  .svc { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--c-line); }
  .svc a { display: grid; grid-template-columns: 4rem 1fr auto; align-items: center; gap: 1rem; padding: 1.3rem 0; border-bottom: 1px solid var(--c-line); text-decoration: none; }
  .svc__n { color: var(--c-muted); font-variant-numeric: tabular-nums; }
  .svc__t { font: 700 clamp(1.35rem, 3vw, 2.1rem)/1.1 var(--f-display); }
  .svc__t small { display: block; font: 400 .95rem/1.4 var(--f-body); color: var(--c-muted); margin-top: .35rem; }
  .svc__arrow { font-size: 1.5rem; color: var(--c-muted); transition: transform .2s, color .2s; }
  .svc a:hover .svc__arrow { transform: translateX(6px); color: var(--c-ink); }
  .svc a:hover .svc__n { color: var(--c-ink); }
  .svc a { background: linear-gradient(var(--c-neon), var(--c-neon)) no-repeat 0 100% / 0 3px; transition: background-size .35s ease; }
  .svc a:hover { background-size: 100% 3px; }

  .duo__head { max-width: 760px; margin-bottom: clamp(24px, 3vw, 40px); }
  .duo__head h2 { font-size: clamp(2rem, 4vw, 3.2rem); }
  .duo__head p { font-size: 1.12rem; }
  .ferns .eyebrow, .ferns .duo__head p { color: color-mix(in srgb, var(--c-on-dark) 75%, transparent); }
  .duo__more { margin: 2.4rem 0 0; }

  .shop { background: var(--c-grey); padding-block: clamp(48px, 7vw, 80px); }
  .shop__in { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .shop h2 { margin-bottom: .3em; }
  .shop p { color: var(--c-muted); max-width: 48ch; margin: 0; }
  .shop__cta { display: flex; align-items: center; gap: 1.4rem; }

  @media (max-width: 760px) {
    .intro__cols { grid-template-columns: 1fr; text-align: center; }
    .intro :global(.social) { justify-content: center; margin-left: 0; }
    .svc a { grid-template-columns: 2.5rem 1fr; }
    .svc__arrow { display: none; }
  }
</style>
