---
// Like the old project template: full-width image, dark band with title, date and
// description, then the images/videos, then "Autres réalisations".
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { getProjets } from '../../lib/projets';

export async function getStaticPaths() {
  const projets = await getProjets();
  return projets.map((entry, i) => {
    // 4 other projects, continuing after this one in the list
    const others = [1, 2, 3, 4].map((k) => projets[(i + k) % projets.length]);
    return { params: { id: entry.id }, props: { entry, others } };
  });
}

const { entry, others } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const date = d.date?.toLocaleDateString('fr-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={d.title} description={d.summary} image={d.cover}>
  <article>
    <header class="phead">
      {d.cover && <div class="phead__img"><Img src={d.cover} alt="" eager sizes="100vw" /></div>}
      <div class="phead__band">
        <div class="wrap">
          <h1>{d.title}</h1>
          <p class="phead__meta">
            {date && <time datetime={d.date?.toISOString().slice(0, 10)}>{date}</time>}
            {d.categories.length > 0 && <span>{d.categories.join(', ')}</span>}
          </p>
          <div class="phead__txt prose"><Content /></div>
        </div>
      </div>
    </header>

    <div class="media wrap">
      {d.videos.map((id) => (
        <div class="video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${id}`}
            title={`${d.title} (vidéo)`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      ))}
      {d.gallery.map((src, i) => <Img src={src} alt={`${d.title}, image ${i + 1}`} />)}
    </div>
  </article>

  <section class="section others">
    <div class="wrap">
      <h2 class="center">Autres réalisations</h2>
      <ProjectGrid projets={others} />
      <p class="center all"><a class="btn" href="/projets/">Tous les projets</a></p>
    </div>
  </section>
</Base>

<style>
  .phead__img { background: var(--c-dark); position: relative; }
  .phead__img :global(img) { max-height: 78vh; object-fit: cover; }
  .phead__img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 55%, var(--c-dark)); pointer-events: none; }
  .phead__band { background: var(--c-dark); color: var(--c-on-dark); padding: 18px 0 44px; }
  .phead h1 { font-size: clamp(1.9rem, 4.5vw, 3.2rem); max-width: 26ch; margin-bottom: .3em; }
  .phead__meta { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: .88rem; color: color-mix(in srgb, var(--c-on-dark) 65%, transparent); margin-bottom: 1.4rem; }
  .phead__meta span { font-style: italic; }
  .phead__txt { max-width: 72ch; font-size: 1.05rem; }
  .phead__txt :global(a) { color: var(--c-brand-light); }

  .media { display: grid; gap: clamp(16px, 3vw, 32px); padding-block: clamp(32px, 5vw, 64px); max-width: 1000px; justify-items: center; }
  .media > :global(img) { width: auto !important; max-width: 100%; }
  .video { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .others { background: var(--c-grey); }
  .others h2 { margin-bottom: 1.2em; }
  .all { margin: 12px 0 0; }
</style>
