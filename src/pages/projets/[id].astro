---
// Like the old project template: full-width image, dark band with title, status,
// categories and description, then images/videos, then "Autres réalisations".
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import ProjectTiles from '../../components/ProjectTiles.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import { getProjets, heroImageFor } from '../../lib/projets';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projets = await getProjets();
  return projets.map((entry, i) => {
    const others = [1, 2, 3, 4].map((k) => projets[(i + k) % projets.length]);
    // Resolve a series' `episodes` (project ids) to the actual entries, so the page can read
    // each episode's own title/videos without a second content-collection call per render.
    const episodes = entry.data.episodes
      .map((id) => projets.find((p) => p.id === id))
      .filter((p) => p !== undefined);
    return { params: { id: entry.id }, props: { entry, others, episodes } };
  });
}

const { entry, others, episodes } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// Prefer a landscape photo for the wide hero band when the project has one (see heroImageFor);
// `d.cover` itself is untouched, so it still drives the grid thumbnail and the OG image below.
const heroSrc = heroImageFor(d);
// One flat list of grid items for the photo masonry: gallery images with each "statement" (a
// big one-liner) inserted at its `after` position as its own tile, alternating which column it
// sits in on wide screens (see .media__quote--left/--right below) instead of breaking the grid
// into separate chunks.
type MediaItem = { kind: 'image'; src: string } | { kind: 'quote'; text: string; side: 'left' | 'right' };
const mediaItems: MediaItem[] = [];
{
  const sorted = [...d.statements].sort((a, b) => a.after - b.after);
  let cursor = 0;
  let quoteCount = 0;
  for (const s of sorted) {
    const upTo = Math.max(cursor, Math.min(s.after, d.gallery.length));
    for (; cursor < upTo; cursor++) mediaItems.push({ kind: 'image', src: d.gallery[cursor] });
    mediaItems.push({ kind: 'quote', text: s.text, side: quoteCount % 2 === 0 ? 'left' : 'right' });
    quoteCount++;
  }
  for (; cursor < d.gallery.length; cursor++) mediaItems.push({ kind: 'image', src: d.gallery[cursor] });
}

// Portrait videos (e.g. YouTube Shorts) get their own full-width, side-by-side carousel sized
// to their own 9:16 box; landscape/square videos get a separate carousel below, each box sized
// to its own ratio. Keeps a vertical clip from being squeezed into (or a widescreen one from
// being stretched into) the wrong shape.
const portraitVideos = d.videos.filter((v) => v.ratio === 'portrait');
const otherVideos = d.videos.filter((v) => v.ratio !== 'portrait');

// For a series (`episodes` set): one slider with the series' own trailer first, then each
// episode's own trailer in order — instead of a separate "series trailer" block and a second
// carousel of episode trailers. Replaces the normal video block(s) entirely for this page.
const seriesVideos =
  episodes.length > 0
    ? [
        ...(d.videos.length > 0 ? [{ id: d.videos[0].id, title: `${d.title} (bande-annonce)` }] : []),
        ...episodes
          .filter((ep) => ep.data.videos.length > 0)
          .map((ep) => ({ id: ep.data.videos[0].id, title: `${ep.data.title} (bande-annonce)` })),
      ]
    : [];
---
<Base title={d.title} description={d.summary} image={d.cover}>
  {/* Kept out of <article> on purpose: <article> below gets an opaque full-bleed background
      (needed so its content never lets the fixed hero image bleed through side gutters), and
      that would also cover .phead__spacer's transparent reveal window if it were inside it. */}
  <header class="phead">
    {d.cover ? (
      <>
        {/* True fixed background (z-index:-1, see the style block below): the image never
            moves. .phead__spacer right after is transparent and just reserves the scroll
            height, so .phead__band (opaque) scrolls up and covers the image once past it. */}
        <div class="phead__fixedbg" aria-hidden="true"><Img src={heroSrc} alt="" eager sizes="100vw" fill /></div>
        <div class="phead__spacer"></div>
      </>
    ) : (
      <div class="phead__ph" aria-hidden="true"></div>
    )}
    <div class="phead__band">
      <div class="wrap">
        {d.status && <p class="phead__status">{d.status}</p>}
        <h1>{d.title}</h1>
        {(d.categories.length > 0 || d.ai) && (
          <ul class="phead__cats">
            {d.categories.map((c) => <li><a href={`/projets/#${encodeURIComponent(c)}`}>{c}</a></li>)}
            {d.ai && <li><a class="is-ai" href="/projets/#IA" title="Projet réalisé avec des outils d'IA">IA</a></li>}
          </ul>
        )}
        <div class="phead__txt prose"><Content /></div>
        {(d.links.length > 0 || d.shop) && (
          <p class="phead__links">
            {d.links.map((l) => <a class="btn btn--light" href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label} ↗</a>)}
            {d.shop && <a class="btn" href="/boutique/">Boutique</a>}
          </p>
        )}
        {d.shop && <p class="phead__shop">{d.shop}</p>}
      </div>
    </div>
  </header>

  <article>
    {site.showTodo && d.todo.length > 0 && (
      <aside class="todo wrap">
        <strong>À compléter</strong>
        <ul>{d.todo.map((t) => <li>{t}</li>)}</ul>
      </aside>
    )}

    {seriesVideos.length > 0 && (
      // One slider for every video of the series: the series' own trailer first, then each
      // episode's, in order — right after the cover and the project's presentation (the header
      // above), before anything else on the page. Sized up a notch from the standard video row
      // (see .vrow--series below) since video is the main way this project presents itself.
      <div class="vrow-wrap">
        <div class="vrow vrow--wide vrow--series" role="list" aria-label={`Vidéos, ${d.title}`}>
          {seriesVideos.map((v) => (
            <div class="vrow__item vrow__item--landscape" role="listitem">
              <YouTubeFacade id={v.id} title={v.title} />
            </div>
          ))}
        </div>
        {seriesVideos.length > 1 && (
          <>
            <button class="vrow-nav vrow-nav--prev" type="button" aria-label="Vidéo précédente">‹</button>
            <button class="vrow-nav vrow-nav--next" type="button" aria-label="Vidéo suivante">›</button>
          </>
        )}
      </div>
    )}

    {/* Trailer(s) up top, before the photos — only for projects that ask for it (`videoFirst`
        in the frontmatter), so every other project page keeps its current order (photos, then
        video) and only opts in explicitly. Skipped entirely for a series (`episodes` above
        already shows this project's own trailer). */}
    {d.videoFirst && seriesVideos.length === 0 && (
      <>
        {portraitVideos.length > 0 && (
          <div class="vrow-wrap">
            <div class="vrow vrow--portrait" role="list" aria-label={`Vidéos verticales, ${d.title}`}>
              {portraitVideos.map((v) => (
                <div class="vrow__item" role="listitem">
                  <YouTubeFacade id={v.id} title={`${d.title} (vidéo)`} />
                </div>
              ))}
            </div>
            {portraitVideos.length > 1 && (
              <>
                <button class="vrow-nav vrow-nav--prev" type="button" aria-label="Vidéo précédente">‹</button>
                <button class="vrow-nav vrow-nav--next" type="button" aria-label="Vidéo suivante">›</button>
              </>
            )}
          </div>
        )}
        {otherVideos.length > 0 && (
          // A single trailer leading the page (the common case) is shown big and centered, well
          // past the standard video row's width (see .vrow--lead below) — the same treatment as
          // a series' combined slider, since here too the video is the main way the project
          // presents itself. More than one video falls back to the normal full-width row, since
          // "centered and oversized" stops making sense once there's a set to scroll through.
          <div class="vrow-wrap">
            <div class={`vrow vrow--wide ${otherVideos.length === 1 ? 'vrow--lead' : ''}`} role="list" aria-label={`Vidéos, ${d.title}`}>
              {otherVideos.map((v) => (
                <div class={`vrow__item vrow__item--${v.ratio}`} role="listitem">
                  <YouTubeFacade id={v.id} title={`${d.title} (vidéo)`} />
                </div>
              ))}
            </div>
            {otherVideos.length > 1 && (
              <>
                <button class="vrow-nav vrow-nav--prev" type="button" aria-label="Vidéo précédente">‹</button>
                <button class="vrow-nav vrow-nav--next" type="button" aria-label="Vidéo suivante">›</button>
              </>
            )}
          </div>
        )}
      </>
    )}

    {mediaItems.length > 0 && (
      <div class="media wrap">
        {mediaItems.map((item, i) =>
          item.kind === 'image' ? (
            <Img src={item.src} alt={`${d.title}, image ${i + 1}`} />
          ) : (
            <p class={`media__quote media__quote--${item.side}`}>{item.text}</p>
          ),
        )}
      </div>
    )}

    {episodes.length > 0 && (
      // One section per episode, in listed order — a title-card main image, a couple of stills,
      // its own short pitch and (once set) its runtime. Each episode picks its own images via
      // `thumb` (falls back to `cover`) for the main one and the first two `gallery` entries for
      // the stills, so this needs no extra frontmatter of its own.
      <div class="eplist wrap">
        {episodes.map((ep, i) => (
          <div class="epsec">
            <div class="epsec__main">
              <Img src={ep.data.thumb ?? ep.data.cover ?? ep.data.gallery[0]} alt={ep.data.title} />
            </div>
            <div class="epsec__stills">
              {ep.data.gallery.slice(0, 2).map((src) => <Img src={src} alt={ep.data.title} ratio="4 / 3" />)}
            </div>
            <div class="epsec__info">
              <p class="epsec__num">Épisode {i + 1}</p>
              <h3 class="epsec__title"><a href={`/projets/${ep.id}/`}>{ep.data.title}</a></h3>
              <p class="epsec__text">{ep.data.summary}</p>
              {ep.data.duration && <p class="epsec__duration">{ep.data.duration}</p>}
            </div>
          </div>
        ))}
      </div>
    )}

    {!d.videoFirst && seriesVideos.length === 0 && portraitVideos.length > 0 && (
      <div class="vrow-wrap">
        <div class="vrow vrow--portrait" role="list" aria-label={`Vidéos verticales, ${d.title}`}>
          {portraitVideos.map((v) => (
            <div class="vrow__item" role="listitem">
              <YouTubeFacade id={v.id} title={`${d.title} (vidéo)`} />
            </div>
          ))}
        </div>
        {portraitVideos.length > 1 && (
          <>
            <button class="vrow-nav vrow-nav--prev" type="button" aria-label="Vidéo précédente">‹</button>
            <button class="vrow-nav vrow-nav--next" type="button" aria-label="Vidéo suivante">›</button>
          </>
        )}
      </div>
    )}

    {!d.videoFirst && seriesVideos.length === 0 && otherVideos.length > 0 && (
      <div class="vrow-wrap">
        <div class="vrow vrow--wide" role="list" aria-label={`Vidéos, ${d.title}`}>
          {otherVideos.map((v) => (
            <div class={`vrow__item vrow__item--${v.ratio}`} role="listitem">
              <YouTubeFacade id={v.id} title={`${d.title} (vidéo)`} />
            </div>
          ))}
        </div>
        {otherVideos.length > 1 && (
          <>
            <button class="vrow-nav vrow-nav--prev" type="button" aria-label="Vidéo précédente">‹</button>
            <button class="vrow-nav vrow-nav--next" type="button" aria-label="Vidéo suivante">›</button>
          </>
        )}
      </div>
    )}
  </article>

  <script>
    // Video carousels: click-to-scroll arrows for pointer/mouse users (the row itself already
    // scrolls with a trackpad or touch). Hidden entirely on narrow screens (see CSS), where the
    // native swipe + scroll-snap is the whole interaction.
    document.querySelectorAll<HTMLElement>('.vrow-wrap').forEach((wrap) => {
      const row = wrap.querySelector<HTMLElement>('.vrow');
      const first = row?.firstElementChild as HTMLElement | null;
      if (!row || !first) return;
      const scrollByOne = (dir: 1 | -1) => {
        const gap = parseFloat(getComputedStyle(row).columnGap || getComputedStyle(row).gap || '16');
        row.scrollBy({ left: dir * (first.getBoundingClientRect().width + gap), behavior: 'smooth' });
      };
      wrap.querySelector('.vrow-nav--prev')?.addEventListener('click', () => scrollByOne(-1));
      wrap.querySelector('.vrow-nav--next')?.addEventListener('click', () => scrollByOne(1));

      // Mouse drag-to-scroll, same grab/grabbing hand as the homepage carousel (see Carousel.astro)
      // — touch already scrolls the row natively, so this only kicks in for mouse/pen input.
      row.addEventListener('dragstart', (e) => e.preventDefault());
      const DRAG_CONFIRM = 6; // px of movement before a press counts as a drag rather than a click
      let pointerDown = false, dragging = false, startX = 0, startScroll = 0;
      row.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'touch' || e.button !== 0) return;
        pointerDown = true; dragging = false;
        startX = e.clientX; startScroll = row.scrollLeft;
        // Closes the hand immediately on press, before we know if this will become a drag — a
        // plain click still shows a quick "grab" flash and then plays the video normally, exactly
        // like the homepage carousel's own click-vs-drag handling.
        row.classList.add('is-pressed');
      });
      row.addEventListener('pointermove', (e) => {
        if (!pointerDown) return;
        const dx = e.clientX - startX;
        if (!dragging) {
          if (Math.abs(dx) < DRAG_CONFIRM) return;
          dragging = true;
          row.classList.add('is-dragging');
          // Only captured once a real drag is confirmed — see Carousel.astro's comment on why
          // capturing on every press would break plain clicks (they'd stop reaching the facade).
          row.setPointerCapture(e.pointerId);
        }
        row.scrollLeft = startScroll - dx;
      });
      const endDrag = () => {
        if (!pointerDown) return;
        pointerDown = false;
        row.classList.remove('is-pressed');
        if (dragging) { dragging = false; row.classList.remove('is-dragging'); }
      };
      row.addEventListener('pointerup', endDrag);
      row.addEventListener('pointercancel', endDrag);
    });
  </script>

  <script>
    // Masonry for the photo grid: rather than every image snapping to the same strict row
    // height (leaving big gaps next to a tall one), each image only spans as many auto-rows as
    // its own rendered height needs — so a short image and a tall one next to it condense
    // upward instead of both being held down to the tall one's row. Degrades to a plain single
    // column with no JS (see the CSS default), which already looks correct.
    const layoutMedia = () => {
      document.querySelectorAll<HTMLElement>('.media').forEach((grid) => {
        grid.classList.add('is-masonry');
        const gap = parseFloat(getComputedStyle(grid).columnGap) || 24;
        Array.from(grid.children).forEach((el) => {
          const item = el as HTMLElement;
          item.style.gridRowEnd = `span ${Math.ceil((item.getBoundingClientRect().height + gap) / 4)}`;
        });
      });
    };
    document.querySelectorAll<HTMLImageElement>('.media img').forEach((img) => img.addEventListener('load', layoutMedia));
    addEventListener('resize', layoutMedia);
    layoutMedia();
    // A quote tile's height depends on the display font, which can finish loading after this
    // first pass — re-measure once it's ready so its row-span isn't stale (that mismatch was
    // the occasional big gap/overlap in the grid).
    document.fonts?.ready?.then(layoutMedia);
  </script>

  <section class="section others">
    <div class="wrap">
      <h2 class="center">Autres réalisations</h2>
      <ProjectTiles projets={others} cols={4} />
      <p class="center all"><a class="btn" href="/projets/">Tous les projets</a></p>
    </div>
  </section>
</Base>

<style>
  .phead__fixedbg { position: fixed; inset: 0; z-index: -1; overflow: hidden; background: var(--c-dark); }
  .phead__fixedbg :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .phead__spacer { height: clamp(320px, 82vh, 900px); }
  .phead__ph { height: clamp(160px, 22vw, 280px); background: linear-gradient(150deg, var(--c-brand), var(--c-dark)); }
  .phead__band { position: relative; background: var(--c-dark); color: var(--c-on-dark); padding: 18px 0 48px; }
  /* Full-bleed opaque layer: keeps the fixed hero image (z-index:-1, above) from bleeding
     through any side gutter or gap below the band, all the way to "Autres réalisations". */
  article { background: var(--c-bg); }
  /* Fades the (fixed, always-sharp-edged) image into the band as it scrolls up to meet it. */
  .phead__band::before { content: ''; position: absolute; left: 0; right: 0; top: -120px; height: 120px; background: linear-gradient(transparent, var(--c-dark)); pointer-events: none; }
  .phead__status { font-size: .8rem; text-transform: uppercase; letter-spacing: .14em; color: var(--c-neon); margin-bottom: .6rem; }
  .phead h1 { font-size: clamp(1.9rem, 4.5vw, 3.2rem); max-width: 26ch; margin-bottom: .5em; }
  .phead__cats { list-style: none; padding: 0; margin: 0 0 1.6rem; display: flex; flex-wrap: wrap; gap: 8px; }
  .phead__cats a { display: block; font-size: .82rem; padding: .3em .85em; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c-on-dark) 35%, transparent); text-decoration: none; }
  .phead__cats a:hover { border-color: var(--c-neon); color: var(--c-neon); }
  .phead__cats a.is-ai { border-color: var(--c-neon); color: var(--c-neon); }
  .phead__txt { max-width: 72ch; font-size: 1.05rem; }
  .phead__txt :global(a) { color: var(--c-neon); }
  .phead__txt :global(blockquote) { margin: 1.4rem 0; padding-left: 1.2rem; border-left: 3px solid var(--c-brand-light); font-style: italic; }
  .phead__txt :global(ul) { padding-left: 1.2rem; }
  .phead__links { display: flex; flex-wrap: wrap; gap: 10px; margin: 1.8rem 0 0; }
  .btn--light { background: var(--c-on-dark); color: var(--c-dark); }
  .btn--light:hover { background: var(--c-neon); }
  .phead__shop { font-size: .92rem; color: color-mix(in srgb, var(--c-on-dark) 70%, transparent); margin: .8rem 0 0; }

  .todo { margin-top: 28px; max-width: 1000px; background: #fdf3cf; border: 2px dashed #d9b43c; color: #4a3b00; padding: 16px 20px; border-radius: var(--radius); }
  .todo strong { text-transform: uppercase; letter-spacing: .08em; font-size: .85rem; }
  .todo ul { margin: .4rem 0 0; padding-left: 1.2rem; }

  .media {
    display: grid; column-gap: clamp(16px, 2vw, 28px); row-gap: clamp(16px, 2vw, 28px);
    padding-block: clamp(32px, 5vw, 64px); padding-inline: clamp(12px, 2vw, 32px);
    max-width: 1900px; justify-items: center; align-items: start;
  }
  .media > :global(img) { width: auto !important; max-width: 100%; }
  /* A big one-liner dropped right into the photo grid as its own tile (see mediaItems above) —
     gives the page rhythm without another paragraph of body text. No boxed background: just the
     brand green on the page's own off-white, with generous air above/below so it reads as a beat
     between photos rather than another heavy block. Sized/positioned like a photo so the masonry
     script (below) measures and slots it in exactly the same way. */
  .media__quote {
    margin: 0; width: 100%; max-width: 640px; box-sizing: border-box;
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: clamp(56px, 9vw, 104px) clamp(20px, 3vw, 40px);
    background: none; color: var(--c-brand);
    font: 800 clamp(1.4rem, 2.8vw, 2.2rem)/1.35 var(--f-display); letter-spacing: -0.01em;
  }
  /* Masonry (see the script above): once JS has measured each image, rows become a fine 4px
     grid with each image spanning just what it needs, so a short image doesn't get held down
     to a tall neighbour's height — several shorter images stack and condense upward instead.
     `dense` refills any holes left when a quote tile is pinned to a column (below) with whatever
     photo comes next, instead of leaving a gap sitting empty until the grid reaches that column
     on its own — that gap was the "big jump" in the flow. */
  .media.is-masonry { grid-auto-rows: 4px; row-gap: 0; grid-auto-flow: dense; }
  @media (min-width: 1440px) {
    /* Two columns from ~18" monitors up — smaller/laptop screens keep one big full-width photo. */
    .media { grid-template-columns: repeat(2, 1fr); grid-auto-flow: dense; }
    .media > :global(img) { width: 100% !important; }
    .media__quote { max-width: none; }
    /* Alternates which column a quote tile lands in — set explicitly (rather than relying on
       auto-placement) so consecutive quotes don't both happen to fall in the same column. */
    .media__quote--left { grid-column: 1; }
    .media__quote--right { grid-column: 2; }
  }

  /* Videos: a horizontally-scrolling, full-width row (not boxed into `.media`'s max-width), so
     several can sit side by side. Portrait clips (Shorts, etc.) get their own row so they don't
     mix with 16:9/square ones — each item's box matches its own video's ratio, never stretched
     or letterboxed. Query params on the iframe (see above) already keep YouTube's own UI to a
     minimum; there's nothing more layered on top here. */
  .vrow-wrap { position: relative; }
  .vrow {
    display: flex; gap: clamp(12px, 2vw, 24px);
    padding: clamp(12px, 2.5vw, 28px) var(--gutter);
    overflow-x: auto; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch;
    scrollbar-width: none; -ms-overflow-style: none; /* the arrows (or a swipe on mobile) are the UI, not a visible scrollbar */
  }
  .vrow::-webkit-scrollbar { display: none; }
  /* Same drag language as the homepage carousel: the row itself is "grab to scroll" (the base
     cursor here), and the facade's own play button is the one thing that reads as clickable (its
     own cursor rule, in YouTubeFacade.astro, wins locally). While actually dragging, the closed
     hand overrides everything underneath it, including the play button — !important because that
     override has to beat the facade's own more specific, differently-scoped rule regardless of
     stylesheet order. */
  .vrow, .vrow :global(*) { cursor: var(--cursor-grab); }
  .vrow.is-pressed, .vrow.is-pressed :global(*) { cursor: var(--cursor-grabbing) !important; }
  .vrow.is-pressed { user-select: none; }
  .vrow.is-pressed :global(*) { user-select: none; }
  /* Disabled only while a real drag is in progress (see the JS) so scroll-snap isn't fighting the
     manual scrollLeft updates; a plain click never reaches this state at all. */
  .vrow.is-dragging { scroll-snap-type: none; }
  .vrow__item { position: relative; flex: none; background: #000; scroll-snap-align: start; }
  .vrow__item iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vrow--portrait .vrow__item { height: clamp(340px, 62vh, 620px); aspect-ratio: 9 / 16; }
  .vrow--wide .vrow__item { height: clamp(200px, 34vw, 440px); }
  .vrow--wide .vrow__item--landscape { aspect-ratio: 16 / 9; }
  .vrow--wide .vrow__item--square { aspect-ratio: 1 / 1; }
  /* A series' combined video slider (see seriesVideos above): noticeably bigger than the
     standard video row on a large screen, since for a series the videos are a main way the
     project presents itself. Left to the row's own vw scaling below ~900px so it's never
     shrunk on a tablet or phone — full-size there is exactly what "big" should mean. */
  @media (min-width: 900px) {
    .vrow--series .vrow__item { height: clamp(320px, 46vw, 760px); }
  }
  /* A single trailer leading a (non-series) project's page: centered and bigger than the
     standard video row's own 16:9 item — see the videoFirst block above. This is the "big
