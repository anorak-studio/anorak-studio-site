---
// Like the old project template: full-width image, dark band with title, status,
// categories and description, then images/videos, then "Autres réalisations".
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import ProjectTiles from '../../components/ProjectTiles.astro';
import { getProjets, heroImageFor } from '../../lib/projets';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projets = await getProjets();
  return projets.map((entry, i) => {
    const others = [1, 2, 3, 4].map((k) => projets[(i + k) % projets.length]);
    return { params: { id: entry.id }, props: { entry, others } };
  });
}

const { entry, others } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// Prefer a landscape photo for the wide hero band when the project has one (see heroImageFor);
// `d.cover` itself is untouched, so it still drives the grid thumbnail and the OG image below.
const heroSrc = heroImageFor(d);
// Portrait videos (e.g. YouTube Shorts) get their own full-width, side-by-side carousel sized
// to their own 9:16 box; landscape/square videos get a separate carousel below, each box sized
// to its own ratio. Keeps a vertical clip from being squeezed into (or a widescreen one from
// being stretched into) the wrong shape.
const portraitVideos = d.videos.filter((v) => v.ratio === 'portrait');
const otherVideos = d.videos.filter((v) => v.ratio !== 'portrait');
// Trims YouTube's own UI as much as it allows: no related-video suggestions, no annotations,
// muted branding — the goal is to keep as little as possible on top of the video itself.
const videoParams = 'modestbranding=1&rel=0&iv_load_policy=3&playsinline=1';
---
<Base title={d.title} description={d.summary} image={d.cover}>
  {/* Kept out of <article> on purpose: <article> below gets an opaque full-bleed background
      (needed so its content never lets the fixed hero image bleed through side gutters), and
      that would also cover .phead__spacer's transparent reveal window if it were inside it. */}
  <header class="phead">
    {d.cover ? (
      <>
        {/* True fixed background (z-index:-1, see the style block below): the image never
            moves. .phead__spacer right after is transparent and just reserves the scroll
            height, so .phead__band (opaque) scrolls up and covers the image once past it. */}
        <div class="phead__fixedbg" aria-hidden="true"><Img src={heroSrc} alt="" eager sizes="100vw" fill /></div>
        <div class="phead__spacer"></div>
      </>
    ) : (
      <div class="phead__ph" aria-hidden="true"></div>
    )}
    <div class="phead__band">
      <div class="wrap">
        {d.status && <p class="phead__status">{d.status}</p>}
        <h1>{d.title}</h1>
        {(d.categories.length > 0 || d.ai) && (
          <ul class="phead__cats">
            {d.categories.map((c) => <li><a href={`/projets/#${encodeURIComponent(c)}`}>{c}</a></li>)}
            {d.ai && <li><a class="is-ai" href="/projets/#IA" title="Projet réalisé avec des outils d'IA">IA</a></li>}
          </ul>
        )}
        <div class="phead__txt prose"><Content /></div>
        {(d.links.length > 0 || d.shop) && (
          <p class="phead__links">
            {d.links.map((l) => <a class="btn btn--light" href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label} ↗</a>)}
            {d.shop && <a class="btn" href="/boutique/">Boutique</a>}
          </p>
        )}
        {d.shop && <p class="phead__shop">{d.shop}</p>}
      </div>
    </div>
  </header>

  <article>
    {site.showTodo && d.todo.length > 0 && (
      <aside class="todo wrap">
        <strong>À compléter</strong>
        <ul>{d.todo.map((t) => <li>{t}</li>)}</ul>
      </aside>
    )}

    {d.gallery.length > 0 && (
      <div class="media wrap">
        {d.gallery.map((src, i) => <Img src={src} alt={`${d.title}, image ${i + 1}`} />)}
      </div>
    )}

    {portraitVideos.length > 0 && (
      <div class="vrow vrow--portrait" role="list" aria-label={`Vidéos verticales, ${d.title}`}>
        {portraitVideos.map((v) => (
          <div class="vrow__item" role="listitem">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v.id}?${videoParams}`}
              title={`${d.title} (vidéo)`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        ))}
      </div>
    )}

    {otherVideos.length > 0 && (
      <div class="vrow vrow--wide" role="list" aria-label={`Vidéos, ${d.title}`}>
        {otherVideos.map((v) => (
          <div class={`vrow__item vrow__item--${v.ratio}`} role="listitem">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v.id}?${videoParams}`}
              title={`${d.title} (vidéo)`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        ))}
      </div>
    )}
  </article>

  <section class="section others">
    <div class="wrap">
      <h2 class="center">Autres réalisations</h2>
      <ProjectTiles projets={others} cols={4} />
      <p class="center all"><a class="btn" href="/projets/">Tous les projets</a></p>
    </div>
  </section>
</Base>

<style>
  .phead__fixedbg { position: fixed; inset: 0; z-index: -1; overflow: hidden; background: var(--c-dark); }
  .phead__fixedbg :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .phead__spacer { height: clamp(320px, 82vh, 900px); }
  .phead__ph { height: clamp(160px, 22vw, 280px); background: linear-gradient(150deg, var(--c-brand), var(--c-dark)); }
  .phead__band { position: relative; background: var(--c-dark); color: var(--c-on-dark); padding: 18px 0 48px; }
  /* Full-bleed opaque layer: keeps the fixed hero image (z-index:-1, above) from bleeding
     through any side gutter or gap below the band, all the way to "Autres réalisations". */
  article { background: var(--c-bg); }
  /* Fades the (fixed, always-sharp-edged) image into the band as it scrolls up to meet it. */
  .phead__band::before { content: ''; position: absolute; left: 0; right: 0; top: -120px; height: 120px; background: linear-gradient(transparent, var(--c-dark)); pointer-events: none; }
  .phead__status { font-size: .8rem; text-transform: uppercase; letter-spacing: .14em; color: var(--c-neon); margin-bottom: .6rem; }
  .phead h1 { font-size: clamp(1.9rem, 4.5vw, 3.2rem); max-width: 26ch; margin-bottom: .5em; }
  .phead__cats { list-style: none; padding: 0; margin: 0 0 1.6rem; display: flex; flex-wrap: wrap; gap: 8px; }
  .phead__cats a { display: block; font-size: .82rem; padding: .3em .85em; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c-on-dark) 35%, transparent); text-decoration: none; }
  .phead__cats a:hover { border-color: var(--c-neon); color: var(--c-neon); }
  .phead__cats a.is-ai { border-color: var(--c-neon); color: var(--c-neon); }
  .phead__txt { max-width: 72ch; font-size: 1.05rem; }
  .phead__txt :global(a) { color: var(--c-neon); }
  .phead__txt :global(blockquote) { margin: 1.4rem 0; padding-left: 1.2rem; border-left: 3px solid var(--c-brand-light); font-style: italic; }
  .phead__txt :global(ul) { padding-left: 1.2rem; }
  .phead__links { display: flex; flex-wrap: wrap; gap: 10px; margin: 1.8rem 0 0; }
  .btn--light { background: var(--c-on-dark); color: var(--c-dark); }
  .btn--light:hover { background: var(--c-neon); }
  .phead__shop { font-size: .92rem; color: color-mix(in srgb, var(--c-on-dark) 70%, transparent); margin: .8rem 0 0; }

  .todo { margin-top: 28px; max-width: 1000px; background: #fdf3cf; border: 2px dashed #d9b43c; color: #4a3b00; padding: 16px 20px; border-radius: var(--radius); }
  .todo strong { text-transform: uppercase; letter-spacing: .08em; font-size: .85rem; }
  .todo ul { margin: .4rem 0 0; padding-left: 1.2rem; }

  .media {
    display: grid; gap: clamp(16px, 2vw, 28px);
    padding-block: clamp(32px, 5vw, 64px); padding-inline: clamp(12px, 2vw, 32px);
    max-width: 1900px; justify-items: center; align-items: start;
  }
  .media > :global(img) { width: auto !important; max-width: 100%; }
  @media (min-width: 1800px) {
    /* Two columns only past ~22" monitors — smaller/laptop screens keep one big full-width photo. */
    .media { grid-template-columns: repeat(2, 1fr); }
    .media > :global(img) { width: 100% !important; }
  }

  /* Videos: a horizontally-scrolling, full-width row (not boxed into `.media`'s max-width), so
     several can sit side by side. Portrait clips (Shorts, etc.) get their own row so they don't
     mix with 16:9/square ones — each item's box matches its own video's ratio, never stretched
     or letterboxed. Query params on the iframe (see above) already keep YouTube's own UI to a
     minimum; there's nothing more layered on top here. */
  .vrow {
    display: flex; gap: clamp(12px, 2vw, 24px);
    padding: clamp(12px, 2.5vw, 28px) var(--gutter);
    overflow-x: auto; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch;
  }
  .vrow__item { position: relative; flex: none; background: #000; scroll-snap-align: start; }
  .vrow__item iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vrow--portrait .vrow__item { height: clamp(340px, 62vh, 620px); aspect-ratio: 9 / 16; }
  .vrow--wide .vrow__item { height: clamp(200px, 34vw, 440px); }
  .vrow--wide .vrow__item--landscape { aspect-ratio: 16 / 9; }
  .vrow--wide .vrow__item--square { aspect-ratio: 1 / 1; }

  .others { background: var(--c-grey); margin-top: clamp(32px, 5vw, 64px); }
  .others h2 { margin-bottom: 1.2em; }
  .all { margin: 32px 0 0; }
</style>
