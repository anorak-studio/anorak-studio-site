---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Img from '../components/Img.astro';
import { services, site } from '../data/site';
import { getProjets } from '../lib/projets';

// Only link a service to "see the projects" when that category tag is actually used by at
// least one published project — same rule as the Projets page's own filter buttons, so we
// never link to an empty, confusing result.
const projets = await getProjets();
const usedCats = new Set(projets.flatMap((p) => p.data.categories));
---
<Base title="Services" description="Image de marque, réalisation, gamification, web, illustration et pixel art, imprimé : les services d'Anorak Studio.">
  <PageTitle title="Services" />

  <section class="section intro wrap">
    <p class="q">{site.servicesIntro.q}</p>
    {site.servicesIntro.text.map((p) => <p>{p}</p>)}
    <p class="cta"><a class="btn" href="/contact/">Nous écrire</a></p>
  </section>

  <section class="science ferns" data-parallax data-parallax-speed="0.3">
    <div class="ferns-bg parallax__media" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow">{site.approche.eyebrow}</span>
      <p class="science__t">{site.approche.title}</p>
      {site.approche.text.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <div class="list">
    {services.map((s, i) => (
      <section id={s.id} class:list={['svcband', i % 2 === 0 ? 'svcband--paper' : 'svcband--brand']}>
        <article class:list={['svc wrap', { 'svc--rev': i % 2 === 1 }]}>
          <div class="svc__img"><Img src={s.image} alt={s.title} ratio="4 / 3" /></div>
          <div>
            <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s.title}</h2>
            <p class="svc__lead">{s.lead}</p>
            {s.text.map((p) => <p>{p}</p>)}
            {s.sections && s.sections.map((sec) => (
              <div class="svc__section">
                {sec.heading && <h3>{sec.heading}</h3>}
                {sec.paragraphs.map((p) => <p>{p}</p>)}
              </div>
            ))}
            {s.id === 'drone' && site.droneReel && <p><a class="btn btn--light" href={site.droneReel} target="_blank" rel="noopener">Voir la bande-démo drone ↗</a></p>}
            {'designThinking' in s && s.designThinking && (
              <div class="dt">
                <ol class="dt__steps">
                  {s.designThinking.map((step) => <li>{step}</li>)}
                </ol>
                <p class="dt__note">{s.designThinkingNote}</p>
              </div>
            )}
            {s.category && usedCats.has(s.category) && (
              <p class="svc__tag">
                <a href={`/projets/#${encodeURIComponent(s.category)}`}>Voir les projets « {s.category} » →</a>
              </p>
            )}
          </div>
        </article>
      </section>
    ))}
  </div>

  <section class="section wrap ai-note">
    <p>{site.aiNote}</p>
  </section>
</Base>

<style>
  .intro { max-width: 780px; text-align: center; }
  .intro .q { font: 700 clamp(1.4rem, 3vw, 2rem)/1.2 var(--f-display); margin-bottom: .8em; }
  .intro p { color: var(--c-muted); font-size: 1.08rem; }
  .intro .q { color: var(--c-ink); }
  .cta { margin-top: 1.6rem; }

  .science { padding-block: clamp(56px, 8vw, 100px); }
  .science .eyebrow { color: var(--c-neon); }
  .science__t { font: 800 clamp(1.9rem, 4.5vw, 3.2rem)/1.05 var(--f-display); max-width: 18ch; }
  .science p:last-child { max-width: 60ch; font-size: 1.12rem; color: color-mix(in srgb, var(--c-on-dark) 82%, transparent); margin: 0; }

  .list { display: block; }

  /* Each service is its own full-bleed band, alternating the site's off-white/beige
     background with the brand forest green — the same rhythm as the homepage's big
     bands — instead of one long uniform list. */
  .svcband { padding-block: clamp(48px, 8vw, 100px); }
  .svcband--paper { background: var(--c-bg); }
  .svcband--brand { background: var(--c-brand); color: var(--c-brand-ink); }

  .svc { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 64px); align-items: center; scroll-margin-top: calc(var(--hdr-h) + 16px); }
  .svc--rev .svc__img { order: 2; }
  .svc__img { border-radius: var(--radius); overflow: hidden; }
  .svc h2 { margin-bottom: .3em; }
  .svc .eyebrow { color: var(--c-brand); }
  .svc__lead { font-weight: 600; color: var(--c-brand); }
  .svc p { max-width: 50ch; }
  .svc p:not(.svc__lead) { color: var(--c-muted); }
  @media (max-width: 760px) { .svc { grid-template-columns: 1fr; } .svc--rev .svc__img { order: 0; } }

  /* On a green band, swap the brand-green accents for the light on-dark palette so
     everything stays legible — same content, just re-tinted for the background. */
  .svcband--brand .svc .eyebrow,
  .svcband--brand .svc__lead { color: var(--c-brand-light); }
  .svcband--brand .svc p:not(.svc__lead) { color: color-mix(in srgb, var(--c-brand-ink) 82%, transparent); }
  .svcband--brand .svc__section h3 { color: var(--c-brand-ink); }
  .svcband--brand .dt { border-top-color: color-mix(in srgb, var(--c-brand-ink) 30%, transparent); }
  .svcband--brand .dt__steps li { background: color-mix(in srgb, var(--c-brand-ink) 16%, transparent); color: var(--c-brand-ink); }
  .svcband--brand .dt__steps li::before { color: var(--c-brand-light); }
  .svcband--brand .dt__note { color: color-mix(in srgb, var(--c-brand-ink) 70%, transparent); }
  .svcband--brand .btn { background: var(--c-neon); color: #000; }
  .btn--light { background: var(--c-on-dark); color: var(--c-dark); }
  .btn--light:hover { background: var(--c-neon); color: #000; }

  .svc__section { margin-top: 1.2rem; }
  .svc__section h3 { font: 700 1.05rem/1.3 var(--f-display); margin-bottom: .4em; }
  .svc__section p { max-width: 50ch; color: var(--c-muted); }

  .svc__tag { margin-top: 1.4rem; }
  .svc__tag a {
    display: inline-block; font: 600 .92rem/1 var(--f-body); padding: .55em 1.1em;
    border-radius: 999px; border: 1px solid var(--c-line); color: var(--c-ink);
    text-decoration: none; transition: border-color .2s, box-shadow .2s, color .2s;
  }
  .svc__tag a:hover { border-color: var(--c-neon); box-shadow: inset 0 0 0 1px var(--c-neon); }
  .svcband--brand .svc__tag a {
    border-color: color-mix(in srgb, var(--c-brand-ink) 35%, transparent);
    color: var(--c-brand-ink);
  }
  .svcband--brand .svc__tag a:hover { border-color: var(--c-neon); color: var(--c-neon); }

  .ai-note { max-width: 900px; text-align: center; padding-block: clamp(56px, 9vw, 110px); }
  .ai-note p { color: var(--c-brand); font: 800 clamp(1.4rem, 3.2vw, 2.3rem)/1.35 var(--f-display); margin: 0; }

  /* Design Thinking: 5-stage placeholder, ready to receive a real visual later. */
  .dt { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px dashed var(--c-line); }
  .dt__steps { list-style: none; margin: 0 0 .6rem; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; counter-reset: dt; }
  .dt__steps li { counter-increment: dt; font: 600 .85rem/1 var(--f-body); padding: .6em 1em; border-radius: 999px; background: var(--c-grey); }
  .dt__steps li::before { content: counter(dt) '. '; color: var(--c-brand); }
  .dt__note { font-size: .82rem; color: var(--c-muted); font-style: italic; margin: 0; }
</style>
