---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { services, site } from '../data/site';
---
<Base title="Services" description="Identité visuelle, imprimé et édition, web et multimédias, illustration, publicité.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Services</span>
      <h1>Vous êtes sur le point de lancer un projet?</h1>
      <p class="lead">
        Appelez-nous pour en parler! Nous participons régulièrement à plusieurs étapes de démarrage
        d'entreprises et au lancement de différents projets.
      </p>
      <a class="btn" href={site.phoneHref}>{site.phone}</a>
    </div>
  </section>

  <section class="wrap list">
    {services.map((s, i) => (
      <article id={s.id} class:list={['svc', { 'svc--rev': i % 2 === 1 }]}>
        <div class="svc__img"><Img src={s.image} alt={s.title} ratio="4 / 3" /></div>
        <div class="svc__txt">
          <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
          <h2>{s.title}</h2>
          <p>{s.text}</p>
        </div>
      </article>
    ))}
  </section>
</Base>

<style>
  h1 { max-width: 16ch; color: var(--c-brand); }
  .lead { margin-bottom: 2rem; }
  .list { padding-bottom: clamp(56px, 9vw, 120px); display: grid; gap: clamp(48px, 8vw, 110px); }
  .svc { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 72px); align-items: center; scroll-margin-top: 96px; }
  .svc--rev .svc__img { order: 2; }
  .svc__img { border-radius: var(--radius); overflow: hidden; }
  .svc p { font-size: 1.15rem; color: var(--c-muted); max-width: 48ch; }
  @media (max-width: 760px) { .svc { grid-template-columns: 1fr; } .svc--rev .svc__img { order: 0; } }
</style>
