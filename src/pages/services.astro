---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Img from '../components/Img.astro';
import { services, servicesIntro, site } from '../data/site';
---
<Base title="Services" description="Identité visuelle, imprimé et édition, web et multimédias, illustration, publicité.">
  <PageTitle title="Services" />

  <section class="section intro wrap">
    <p class="q">{servicesIntro.question}</p>
    {servicesIntro.answer.map((p) => <p>{p}</p>)}
    <p class="cta"><a class="btn" href={site.phoneHref}>{site.phone}</a></p>
  </section>

  <section class="wrap list">
    {services.map((s) => (
      <article id={s.id} class="svc">
        <h2>{s.title}</h2>
        <Img src={s.image} alt={s.title} />
        {s.text.map((p) => <p>{p}</p>)}
      </article>
    ))}
  </section>
</Base>

<style>
  .intro { max-width: 780px; text-align: center; }
  .intro .q { font: 700 clamp(1.4rem, 3vw, 2rem)/1.2 var(--f-display); margin-bottom: .8em; }
  .intro p { color: var(--c-muted); font-size: 1.08rem; }
  .intro .q { color: var(--c-ink); }
  .cta { margin-top: 1.6rem; }

  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr)); gap: 0 clamp(24px, 4vw, 50px); padding-bottom: clamp(48px, 7vw, 96px); }
  .svc { padding: 25px 0; scroll-margin-top: calc(var(--hdr-h) + 16px); }
  .svc h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .svc :global(img) { margin: 0 0 1.2rem; }
  .svc p { color: var(--c-muted); }
</style>
