---
// Image from /public with its real width/height (read at build time, so pages don't jump
// while loading). If the file is missing, shows a striped placeholder instead of a broken image.
import fs from 'node:fs';
import path from 'node:path';
import { imageDims } from '../lib/image-dims';

interface Props {
  src?: string;
  alt: string;
  ratio?: string; // e.g. '4 / 3', or 'auto' for the image's own shape
  class?: string;
  eager?: boolean;
  sizes?: string;
  fill?: boolean; // absolutely-position to cover the parent instead of sizing to its own ratio
  parallax?: boolean; // with fill: oversize (132%) so a JS translateY never reveals empty edges
}
const { src, alt, ratio = 'auto', class: cls = '', eager = false, sizes, fill = false, parallax = false } = Astro.props;
const file = src ? path.join(process.cwd(), 'public', decodeURI(src)) : '';
const exists = !!src && fs.existsSync(file);
const wh = src && exists ? imageDims(src) : null;
const style = fill
  ? parallax
    ? 'position:absolute;left:0;top:-20%;width:100%;height:140%;object-fit:cover;will-change:transform'
    : 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover'
  : ratio === 'auto' ? 'width:100%;height:auto' : `aspect-ratio:${ratio};object-fit:cover;width:100%`;
const cls2 = parallax ? `${cls} parallax__media`.trim() : cls;
---
{exists ? (
  <img
    src={src}
    alt={alt}
    class={cls2}
    width={wh?.[0]}
    height={wh?.[1]}
    sizes={sizes}
    style={style}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
) : (
  <div class={`img-missing ${cls}`} style={`aspect-ratio:${ratio === 'auto' ? '4 / 3' : ratio}`} role="img" aria-label={alt}>
    <span>{src ? `Image à venir : ${src.split('/').pop()}` : 'Image à venir'}</span>
  </div>
)}
