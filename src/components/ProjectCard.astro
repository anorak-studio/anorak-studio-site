---
import Img from './Img.astro';
interface Props { id: string; title: string; summary: string; categories: string[]; cover?: string; }
const { id, title, summary, categories, cover } = Astro.props;
---
<a class="card" href={`/projets/${id}/`} data-cats={categories.join('|')}>
  <div class="card__img"><Img src={cover} alt={title} ratio="4 / 3" /></div>
  <div class="card__meta">{categories.join(' · ')}</div>
  <h3>{title}</h3>
  <p>{summary}</p>
</a>

<style>
  .card { display: block; text-decoration: none; color: inherit; }
  .card__img { overflow: hidden; border-radius: var(--radius); margin-bottom: 1rem; }
  .card__img :global(img), .card__img :global(.img-missing) { transition: transform .5s ease; }
  .card:hover .card__img :global(img) { transform: scale(1.04); }
  .card__meta { font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; color: var(--c-muted); margin-bottom: .4rem; }
  .card h3 { margin-bottom: .25rem; }
  .card p { color: var(--c-muted); margin: 0; }
</style>
