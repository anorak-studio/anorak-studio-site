---
// A grid of project cards with a fixed ratio (16:9 by default: film and game work).
import Img from './Img.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { projets: CollectionEntry<'projets'>[]; dark?: boolean; cols?: number; ratio?: string; }
const { projets, dark = false, cols = 4, ratio = '16 / 9' } = Astro.props;
---
<div class:list={['tiles', { 'tiles--dark': dark }]} style={`--cols:${cols};--ratio:${ratio}`}>
  {projets.map((p) => (
    <a class="tile" href={`/projets/${p.id}/`}>
      <div class="tile__img">
        {p.data.thumb || p.data.cover ? <Img src={p.data.thumb || p.data.cover} alt="" ratio={ratio} /> : <div class="tile__ph"><span>{p.data.title}</span></div>}
      </div>
      <h3>{p.data.title}</h3>
      {p.data.status && <p>{p.data.status}</p>}
    </a>
  ))}
</div>

<style>
  .tiles { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: calc(var(--gap) * 1.6) var(--gap); }
  @media (max-width: 1000px) { .tiles { grid-template-columns: repeat(min(var(--cols), 2), 1fr); } }
  @media (max-width: 560px) { .tiles { grid-template-columns: 1fr; } }
  .tile { text-decoration: none; display: block; min-width: 0; transition: opacity .32s ease, transform .32s ease; }
  .tile__img { position: relative; overflow: hidden; margin-bottom: 12px; background: var(--c-grey); }
  .tile__img::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--c-neon); transform: scaleX(0); transform-origin: left; transition: transform .35s ease; }
  .tile:hover .tile__img::after, .tile:focus-visible .tile__img::after { transform: scaleX(1); }
  .tile__img :global(img) { transition: transform .5s ease; }
  .tile:hover .tile__img :global(img) { transform: scale(1.03); }
  .tile__ph { aspect-ratio: var(--ratio); display: flex; align-items: flex-end; padding: clamp(16px, 2vw, 28px); background: linear-gradient(150deg, color-mix(in srgb, var(--c-brand) 85%, #000), var(--c-dark)); color: var(--c-on-dark); }
  .tile__ph span { font: 800 clamp(1.3rem, 2.2vw, 2rem)/1.05 var(--f-display); }
  .tile h3 { font-size: clamp(1.1rem, 1.4vw, 1.35rem); margin: 0; }
  .tile p { font-size: .9rem; color: var(--c-muted); margin: 4px 0 0; }
  .tiles--dark .tile h3 { color: var(--c-on-dark); }
  .tiles--dark .tile p { color: color-mix(in srgb, var(--c-on-dark) 65%, transparent); }
  .tiles--dark .tile:hover h3 { color: var(--c-neon); }
  .tiles--dark .tile__img { background: rgba(255, 255, 255, .06); }
  .tiles--dark .tile__ph { background: linear-gradient(150deg, rgba(255,255,255,.12), rgba(255,255,255,.03)); }
</style>
