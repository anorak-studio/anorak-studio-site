---
// Full-width carousel, like the original site. Slides come from `carousel` in src/data/site.ts:
// media (image or video), optional text over it (showText), link. Arrows on both sides use the
// chevrons of the old site's Elementor carousel; they turn fluorescent green on hover.
import Media from './Media.astro';
import type { Slide } from '../data/site';
interface Props { slides: Slide[]; }
const { slides } = Astro.props;
const chevronL = 'M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z';
const chevronR = 'M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z';
---
<div class="car" aria-roledescription="carrousel" aria-label="À la une">
  <div class="car__track" tabindex="0">
    {slides.map((s, i) => (
      // Always a <div>, never a link: the image/video is for dragging the carousel only (the
      // grab/grabbing hand cursor), it doesn't navigate on click and doesn't turn into the
      // pointing finger. The one real link per slide is the "voir le projet →" text below.
      <div class="car__slide" aria-roledescription="diapositive" aria-label={`${s.title} (${i + 1} / ${slides.length})`}>
        <Media media={s.media} alt={s.title} fill eager={i === 0} />
        {s.showText && (
          <span class={`car__cap car__cap--${s.position ?? 'bottom-left'}`}>
            <strong>{s.title}</strong>
            {s.text && <span class="car__txt">{s.text}</span>}
            {s.href && s.cta && (
              <a class="car__cta" href={s.href} aria-label={`${s.cta} : ${s.title}`}>{s.cta} →</a>
            )}
          </span>
        )}
      </div>
    ))}
  </div>
  <button class="car__arrow car__prev" aria-label="Précédent"><svg viewBox="0 0 1000 1000" aria-hidden="true"><path d={chevronL} /></svg></button>
  <button class="car__arrow car__next" aria-label="Suivant"><svg viewBox="0 0 1000 1000" aria-hidden="true"><path d={chevronR} /></svg></button>
  <div class="car__dots">{slides.map((s, i) => <button aria-label={s.title} data-i={i} />)}</div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.car').forEach((car) => {
    const track = car.querySelector<HTMLElement>('.car__track')!;
    const dots = [...car.querySelectorAll<HTMLButtonElement>('.car__dots button')];
    const n = dots.length;
    const cur = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: ((i + n) % n) * track.clientWidth, behavior: 'smooth' });
    const mark = () => dots.forEach((d, i) => d.setAttribute('aria-current', String(i === cur())));
    car.querySelector('.car__prev')!.addEventListener('click', () => go(cur() - 1));
    car.querySelector('.car__next')!.addEventListener('click', () => go(cur() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(cur() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur() - 1); }
    });
    track.addEventListener('scroll', () => requestAnimationFrame(mark), { passive: true });
    mark();
    let paused = false;
    car.addEventListener('mouseenter', () => (paused = true));
    car.addEventListener('mouseleave', () => (paused = false));
    car.addEventListener('focusin', () => (paused = true));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => !paused && go(cur() + 1), 6000);

    // Mouse drag-to-swipe: touch already scrolls the track natively, so this only kicks in
    // for mouse (and pen) input — the grab-hand cursor is the visual cue that it's draggable.
    // Images and links are natively draggable in the browser (ghost-image drag-and-drop), which
    // hijacks the gesture before our pointermove handler ever sees it — kill that first.
    track.addEventListener('dragstart', (e) => e.preventDefault());
    // A short, fixed distance is enough to commit to the next/previous slide — dragging further
    // doesn't skip extra slides, it just tracks the finger/cursor until release.
    const SWIPE_THRESHOLD = 60;
    // How far the pointer has to move before a press turns into a drag. This is the actual fix
    // for "voir le projet" not opening: setPointerCapture() retargets every later event of that
    // pointer — including the click — to the element it was called on (the track, a <div>). A
    // click retargeted that way can no longer reach the <a> it was visually inside (the anchor
    // is a descendant of the track, not an ancestor of the retargeted target), so the browser
    // never runs its default navigation — the link looked broken even though the href was fine.
    // Capturing the pointer immediately on every press (as before) meant EVERY click, including
    // a plain unmoved one, got retargeted this way. Now we only capture once real dragging is
    // confirmed (past DRAG_CONFIRM px), so a plain click never captures the pointer at all and
    // reaches the anchor exactly like a normal click.
    const DRAG_CONFIRM = 6;
    let pointerDown = false, dragging = false, startX = 0, startLeft = 0, startIndex = 0, pointerId = -1;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0) return;
      pointerDown = true; dragging = false;
      startX = e.clientX; startLeft = track.scrollLeft; startIndex = cur();
      pointerId = e.pointerId;
    });
    track.addEventListener('pointermove', (e) => {
      if (!pointerDown) return;
      const dx = e.clientX - startX;
      if (!dragging) {
        if (Math.abs(dx) < DRAG_CONFIRM) return;
        dragging = true;
        // is-dragging: cursor + no text selection, dropped the instant the button is released.
        // is-settling: keeps scroll-snap disabled through the release animation too — re-enabling
        // it right away would make the browser instantly re-snap to the nearest slide (usually
        // still the start one) before our smooth scrollTo below even runs, so it visibly jumped
        // back to the start first instead of continuing on from wherever the drag left off.
        track.classList.add('is-dragging', 'is-settling');
        track.setPointerCapture(pointerId);
      }
      track.scrollLeft = startLeft - dx;
    });
    const endDrag = (e: PointerEvent) => {
      if (!pointerDown) return;
      pointerDown = false;
      if (!dragging) return; // a plain click/tap: nothing to settle, let the browser handle it
      dragging = false;
      track.classList.remove('is-dragging');
      const dx = e.clientX - startX;
      // Past the threshold, always commit exactly one slide forward/back regardless of how
      // far it was dragged; short of it, spring back to where it started — both animated
      // smoothly by go(), continuing from the exact spot the drag left off.
      const target = dx <= -SWIPE_THRESHOLD ? startIndex + 1 : dx >= SWIPE_THRESHOLD ? startIndex - 1 : startIndex;
      go(target);
      const stopSettling = () => { track.classList.remove('is-settling'); track.removeEventListener('scrollend', stopSettling); };
      track.addEventListener('scrollend', stopSettling);
      setTimeout(stopSettling, 500); // fallback where scrollend isn't supported
    };
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);
  });
</script>

<style>
  .car { position: relative; background: #000; }
  .car__track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  /* Base state: the whole strip is "grab to swipe" (image/background) — the slide itself is
     never a link (see the template), so the image only ever offers the drag cursor, never the
     pointing finger. Caption text reads as text; the "voir le projet →" link is the one real
     clickable thing here and gets its own pointer/click cursor below, at higher specificity. */
  .car__track, .car__track :global(*) { cursor: var(--cursor-grab); }
  .car__cap, .car__cap * { cursor: var(--cursor-text); }
  .car__cap .car__cta { cursor: var(--cursor-point); }
  /* The carousel's own cursor rules above outrank the sitewide :active "clic" rule (same or
     higher specificity from Astro's scoping), so without this the click/press state never
     showed on the CTA link, the arrows or the dots here. Restated locally so it wins. */
  .car__cap .car__cta:active { cursor: var(--cursor-click); }
  .car__track::-webkit-scrollbar { display: none; }
  .car__slide > :global(img), .car__slide > :global(video) { -webkit-user-drag: none; user-drag: none; }
  /* While actively dragging: the closed-hand cursor overrides everything else in the track
     (text, the CTA) — two classes' worth of specificity beats every rule above — no snap
     fighting the drag, and no accidental text selection as the pointer sweeps over captions. */
  .car__track.is-dragging, .car__track.is-dragging :global(*) { cursor: var(--cursor-grabbing); }
  .car__track.is-dragging { user-select: none; }
  .car__track.is-dragging :global(*) { user-select: none; }
  /* Stays disabled a beat past pointer-up too — see the JS comment on is-settling. */
  .car__track.is-settling { scroll-snap-type: none; }
  .car__slide {
    flex: 0 0 100%; scroll-snap-align: start; position: relative; display: block; overflow: hidden;
    aspect-ratio: 16 / 9; max-height: 100vh; min-height: 220px; width: 100%; color: #fff; text-decoration: none;
  }
  .car__slide > :global(img), .car__slide > :global(video), .car__slide > :global(iframe) { object-fit: cover; }
  .car__cap { position: absolute; display: grid; gap: 4px; max-width: min(760px, 86%); padding: clamp(18px, 3vw, 48px) clamp(20px, 5vw, 96px); }
  .car__cap--bottom-left { left: 0; bottom: 0; right: 0; max-width: none; justify-items: start; padding-top: clamp(60px, 10vw, 140px); background: linear-gradient(transparent, rgba(0, 0, 0, .7)); }
  .car__cap--bottom-center { left: 0; right: 0; bottom: 0; max-width: none; justify-items: center; text-align: center; padding-top: clamp(60px, 10vw, 140px); background: linear-gradient(transparent, rgba(0, 0, 0, .7)); }
  .car__cap--center { inset: 0; max-width: none; place-content: center; justify-items: center; text-align: center; background: rgba(0, 0, 0, .3); }
  .car__cap--top-left { left: 0; top: 0; padding-top: calc(var(--hdr-h) + 24px); }
  .car__cap strong { font: 800 clamp(1.8rem, 4.6vw, 4rem)/1.02 var(--f-display); text-shadow: 0 2px 20px rgba(0, 0, 0, .4); }
  .car__txt { font-size: clamp(1rem, 1.6vw, 1.3rem); opacity: .9; }
  .car__cta {
    display: inline-block; font-style: normal; font-weight: 600; margin-top: 10px; color: #fff;
    text-decoration: none; border-bottom: 2px solid var(--c-neon); padding-bottom: 2px; transition: color .2s;
  }
  .car__cta:hover, .car__cta:focus-visible { color: var(--c-neon); }

  .car__arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
    width: clamp(44px, 4.5vw, 64px); height: clamp(44px, 4.5vw, 64px); padding: 0; border: 0; cursor: var(--cursor-point);
    background: transparent; color: #fff; display: grid; place-items: center; transition: color .2s, transform .2s;
    filter: drop-shadow(0 1px 8px rgba(0, 0, 0, .5));
  }
  .car__arrow svg { width: 70%; height: 70%; fill: currentColor; }
  .car__arrow:hover, .car__arrow:focus-visible { color: var(--c-neon); }
  .car__arrow:active { cursor: var(--cursor-click); }
  .car__prev { left: clamp(4px, 1.5vw, 24px); }
  .car__next { right: clamp(4px, 1.5vw, 24px); }
  .car__prev:hover { transform: translateY(-50%) translateX(-3px); }
  .car__next:hover { transform: translateY(-50%) translateX(3px); }
  .car__dots { position: absolute; left: 0; right: 0; bottom: 14px; display: flex; justify-content: center; gap: 10px; z-index: 2; pointer-events: none; }
  .car__dots button { pointer-events: auto; width: 9px; height: 9px; padding: 0; border-radius: 50%; border: 0; background: rgba(255, 255, 255, .45); cursor: var(--cursor-point); }
  .car__dots button[aria-current='true'] { background: var(--c-neon); }
  .car__dots button:active { cursor: var(--cursor-click); }
  @media (max-width: 700px) {
    /* Keep the same true 16:9 ratio on mobile — just crop, never stretch. */
    .car__cta { display: none; }
    .car__dots { bottom: 8px; }
  }
</style>
