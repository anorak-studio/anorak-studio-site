---
// Like the old footer: fern band with the mission quote, social icons,
// big grey menu row, then the address line.
import Social from './Social.astro';
import { site, nav } from '../data/site';
---
<footer>
  <section class="ferns quote">
    <p class="wrap">{site.mission}</p>
  </section>
  <div class="social-row"><Social size={24} /></div>
  <nav class="fnav" aria-label="Pied de page">
    <ul class="wrap">{nav.filter((n) => n.href !== '/').map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
  </nav>
  <p class="addr wrap">
    {site.name}<br />
    {site.address.street}, {site.address.city}, {site.address.country}, {site.address.postal}<br />
    <a href={site.phoneHref}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a>
  </p>
</footer>

<style>
  .quote { padding: clamp(48px, 7vw, 80px) 0; text-align: center; }
  .quote p { margin: 0 auto; max-width: 900px; font: 500 clamp(1.2rem, 2.4vw, 1.6rem)/1.45 var(--f-display); }
  .social-row { display: flex; justify-content: center; padding: 22px 0; }
  .fnav { background: var(--c-grey); }
  .fnav ul { list-style: none; margin: 0 auto; padding-block: 18px 22px; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 44px; }
  .fnav a { text-decoration: none; font: 700 clamp(1.3rem, 3vw, 1.9rem)/1.4 var(--f-display); transition: color .2s; }
  .fnav a:hover { color: var(--c-brand); }
  .addr { text-align: center; font-size: .92rem; color: var(--c-muted); padding-block: 26px 34px; margin: 0 auto; }
  .addr a { text-decoration: none; }
  .addr a:hover { text-decoration: underline; }
</style>
