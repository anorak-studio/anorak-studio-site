---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { size?: number; class?: string; }
const { size = 22, class: cls = '' } = Astro.props;
---
<ul class={`social ${cls}`}>
  {site.social.map((s) => (
    <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={size} /></a></li>
  ))}
</ul>

<style>
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: 18px; }
  .social a { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; transition: color .2s, background .2s; }
  .social a:hover { color: var(--c-brand); background: color-mix(in srgb, currentColor 8%, transparent); }
</style>
