---
// No bar: the ANORAK logo sits directly over the top of the page (every page starts with
// a dark image or banner). The burger (the old site's icon) stays fixed top-right and turns
// fluorescent green on hover; it opens a full-screen menu on black at 70%.
import logo from '../assets/logos/anorak.svg?raw';
import logoStudio from '../assets/logos/anorak-studio.svg?raw';
import Social from './Social.astro';
import { nav } from '../data/site';
const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---
<header class="hdr">
  <a href="/" class="hdr__logo" aria-label="Anorak Studio, accueil" set:html={logo} />
</header>
<button class="burger" aria-controls="menu" aria-expanded="false" aria-label="Ouvrir le menu">
  <svg class="micon" viewBox="0 0 51 38" aria-hidden="true">
    <g class="micon__burger">
      <polygon class="micon__bar micon__bar--top" points="43 11.5 25.5 11.5 8 11.5 8 8.5 25.5 8.5 43 8.5 43 11.5" />
      <rect class="micon__bar micon__bar--mid" x="8" y="17.5" width="35" height="3" />
      <rect class="micon__bar micon__bar--bot" x="8" y="26.5" width="35" height="3" />
    </g>
    <g class="micon__eye">
      <path class="micon__outline" d="M8,19s6.75-10.5,17.5-10.5,17.5,10.5,17.5,10.5c0,0-6.25,10.5-17.5,10.5s-17.5-10.5-17.5-10.5Z" />
      <circle class="micon__pupil" cx="25.5" cy="19" r="4.5" />
      <path class="micon__lid" d="M8,20s6.75-5.5,17.5-5.5,17.5,5.5,17.5,5.5" />
    </g>
  </svg>
</button>

<div id="menu" class="menu" hidden>
  <div class="menu__in">
    <a href="/" class="menu__logo" aria-label="Anorak Studio, accueil" set:html={logoStudio} />
    <hr class="menu__rule" />
    <nav aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <hr class="menu__rule" />
    <Social size={26} class="menu__social" />
  </div>
</div>

<script>
  const hdr = document.querySelector<HTMLElement>('.hdr')!;
  const btn = document.querySelector<HTMLButtonElement>('.burger')!;
  const menu = document.getElementById('menu')!;
  const firstLink = menu.querySelector<HTMLAnchorElement>('nav a')!;
  // Blink-close / blink-open duration: long enough for the lid's opacity fade (CSS, .07s)
  // to fully register, short enough to read as a natural blink.
  const BLINK_TRANSITION_MS = 110;
  let transitioning = false;
  let transitionTimer: ReturnType<typeof setTimeout> | undefined;
  const setOpen = (open: boolean) => {
    clearTimeout(transitionTimer);
    transitioning = true;
    if (open) {
      // The eye fades in already blinked shut (lid down), then opens once it's on screen —
      // mirroring the burger bars sliding together into a flat line before the eye appears.
      eyeGroup.classList.add('is-blinking');
      menu.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Fermer le menu');
      btn.classList.add('is-open');
      document.documentElement.style.overflow = 'hidden';
      firstLink.focus();
      // Let the bars-merge / burger-fade / eye-fade-in sequence (~380ms) finish, then open the
      // lid to reveal the pupil.
      transitionTimer = setTimeout(() => {
        eyeGroup.classList.remove('is-blinking');
        transitioning = false;
      }, 420);
    } else {
      // Blink the eye shut first, then swap back to the burger while it's closed — the
      // reverse of the burger bars merging into a line before the eye appears.
      eyeGroup.classList.add('is-blinking');
      transitionTimer = setTimeout(() => {
        menu.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Ouvrir le menu');
        btn.classList.remove('is-open');
        document.documentElement.style.overflow = '';
        btn.focus();
        cancelIdle();
        centerPupil();
        transitioning = false;
      }, BLINK_TRANSITION_MS);
    }
  };
  btn.addEventListener('click', () => setOpen(menu.hidden));
  menu.addEventListener('click', (e) => { if (e.target === menu) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) setOpen(false); });

  // Burger <-> eye icon: blinking, and a pupil that looks toward the cursor anywhere on screen
  // while the eye is showing (menu open) and the cursor is moving ("looking" state — no
  // blinking then). Once the cursor stops moving for a few seconds, the eye eases back to
  // centered (idle, looking straight at the visitor) and resumes blinking. Respects
  // prefers-reduced-motion.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const micon = btn.querySelector<SVGSVGElement>('.micon')!;
  const eyeGroup = btn.querySelector<SVGGElement>('.micon__eye')!;
  const pupil = btn.querySelector<SVGCircleElement>('.micon__pupil')!;
  const EYE_CX = 25.5, EYE_CY = 19, MAX_R = 2.4;
  const centerPupil = () => { pupil.setAttribute('cx', String(EYE_CX)); pupil.setAttribute('cy', String(EYE_CY)); };
  const lookAt = (clientX: number, clientY: number) => {
    const r = micon.getBoundingClientRect();
    if (!r.width || !r.height) return;
    const cx = r.left + (EYE_CX / 51) * r.width;
    const cy = r.top + (EYE_CY / 38) * r.height;
    const scaleX = 51 / r.width, scaleY = 38 / r.height;
    const dx = (clientX - cx) * scaleX, dy = (clientY - cy) * scaleY;
    const dist = Math.hypot(dx, dy) || 1;
    const mag = Math.min(MAX_R, dist * 0.15);
    pupil.setAttribute('cx', String(EYE_CX + (dx / dist) * mag));
    pupil.setAttribute('cy', String(EYE_CY + (dy / dist) * mag));
  };
  let isLooking = false;
  let idleTimer: ReturnType<typeof setTimeout> | undefined;
  const cancelIdle = () => { if (idleTimer) { clearTimeout(idleTimer); idleTimer = undefined; } isLooking = false; };
  // "Looking" activation radius: while the cursor is within this distance of the icon,
  // the eye looks and no idle countdown runs. Past it, the eye keeps tracking the cursor
  // (at any distance) but a single 3-5s countdown is armed; if it fires before the cursor
  // comes back within range, the eye goes idle (centered, blinking resumes).
  const ACTIVATION_RADIUS = 50;
  if (!reduceMotion) {
    document.addEventListener('mousemove', (e) => {
      if (menu.hidden) return;
      isLooking = true;
      lookAt(e.clientX, e.clientY);
      const r = micon.getBoundingClientRect();
      const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
      const nearIcon = Math.hypot(e.clientX - cx, e.clientY - cy) <= ACTIVATION_RADIUS;
      if (nearIcon) {
        clearTimeout(idleTimer);
        idleTimer = undefined;
      } else if (!idleTimer) {
        idleTimer = setTimeout(() => {
          isLooking = false;
          idleTimer = undefined;
          centerPupil();
        }, 1000);
      }
    });
  }
  let blinkTimer: ReturnType<typeof setTimeout> | undefined;
  const scheduleBlink = () => {
    blinkTimer = setTimeout(() => {
      if (!menu.hidden && !reduceMotion && !isLooking && !transitioning) {
        eyeGroup.classList.add('is-blinking');
        setTimeout(() => eyeGroup.classList.remove('is-blinking'), 140);
      }
      scheduleBlink();
    }, 2600 + Math.random() * 3200);
  };
  scheduleBlink();
  // once the page scrolls past the top, give the logo and burger a dark backdrop so they stay readable
  const onScroll = () => {
    hdr.classList.toggle('is-floating', scrollY > 80);
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .hdr {
    position: fixed; top: 0; left: 0; right: 0; z-index: 20; height: var(--hdr-h); display: flex; align-items: center;
    padding-inline: var(--gutter); pointer-events: none; transition: background .25s ease;
  }
  .hdr.is-floating { background: linear-gradient(rgba(0, 0, 0, .5), transparent); }
  .hdr__logo { pointer-events: auto; display: block; width: clamp(120px, 12vw, 170px); color: #fff; filter: drop-shadow(0 1px 8px rgba(0, 0, 0, .35)); transition: color .2s; }
  .hdr__logo:hover { color: var(--c-neon); }
  .hdr__logo :global(svg) { width: 100%; height: auto; display: block; }

  .burger {
    position: fixed; top: 15px; right: calc(var(--gutter) - 15px); z-index: 55;
    width: 81px; height: 66px; padding: 15px; border: 0; border-radius: 6px; cursor: pointer;
    background: transparent; color: #fff; transition: color .2s;
    filter: drop-shadow(0 1px 6px rgba(0, 0, 0, .35));
  }
  .burger:hover, .burger:focus-visible { color: var(--c-neon); }

  /* Burger <-> eye icon */
  .micon { display: block; width: 100%; height: auto; overflow: visible; }
  .micon__bar { fill: currentColor; transition: transform .22s ease; transition-delay: .18s; }
  .micon__bar--top { transform-origin: 25.5px 10px; }
  .micon__bar--bot { transform-origin: 25.5px 28px; }
  .burger.is-open .micon__bar--top { transform: translateY(9px); transition-delay: 0s; }
  .burger.is-open .micon__bar--bot { transform: translateY(-9px); transition-delay: 0s; }
  .micon__burger { transition: opacity .16s ease; transition-delay: 0s; }
  .burger.is-open .micon__burger { opacity: 0; transition-delay: .2s; }
  .micon__eye {
    opacity: 0; transition: opacity .16s ease; transition-delay: 0s;
    fill: none; stroke: currentColor; stroke-width: 3px; stroke-linecap: round; stroke-miterlimit: 10;
  }
  .burger.is-open .micon__eye { opacity: 1; transition-delay: .22s; }
  .micon__pupil { transition: cx .12s ease, cy .12s ease; }
  .micon__lid { opacity: 0; transition: opacity .07s ease; }
  .micon__eye.is-blinking .micon__outline, .micon__eye.is-blinking .micon__pupil { opacity: 0; }
  .micon__eye.is-blinking .micon__lid { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .micon__bar, .micon__burger, .micon__eye, .micon__pupil, .micon__lid { transition: none; }
  }

  .menu {
    position: fixed; inset: 0; z-index: 50; background: rgba(0, 0, 0, .7); backdrop-filter: blur(4px);
    display: grid; place-items: center; overflow-y: auto; animation: fade .3s ease;
    height: 100svh;
  }
  .menu[hidden] { display: none; }
  @keyframes fade { from { opacity: 0; } }
  .menu__in {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: clamp(10px, 4svh, 88px); padding: clamp(16px, 5svh, 80px) 24px; min-height: 100%;
    color: #fff; text-align: center;
  }
  .menu__logo { width: clamp(150px, 18vw, 240px); color: #fff; flex: none; }
  .menu__logo:hover { color: var(--c-neon); }
  .menu__logo :global(svg) { width: 100%; height: auto; display: block; }
  .menu__rule { width: min(220px, 60%); border: 0; border-top: 2px solid rgba(255, 255, 255, .5); margin: 0; }
  .menu nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(2px, 1svh, 12px); }
  .menu nav a {
    display: inline-block; text-decoration: none; text-transform: uppercase; letter-spacing: .04em;
    font: 800 clamp(1.4rem, 4.8svh, 2.8rem)/1.08 var(--f-display); transition: color .2s;
  }
  .menu nav a:hover, .menu nav a:focus-visible { color: var(--c-neon); }
  .menu nav a[aria-current] { color: color-mix(in srgb, #fff 55%, transparent); }
  .menu nav a[aria-current]:hover { color: var(--c-neon); }
  .menu :global(.menu__social a:hover) { color: var(--c-neon); background: transparent; }
</style>
