---
// No bar: the ANORAK logo sits directly over the top of the page (every page starts with
// a dark image or banner). The burger (the old site's icon) stays fixed top-right and turns
// fluorescent green on hover; it opens a full-screen menu on black at 70%.
import logo from '../assets/logos/anorak.svg?raw';
import logoStudio from '../assets/logos/anorak-studio.svg?raw';
import menuIcon from '../assets/logos/menu.svg?raw';
import Social from './Social.astro';
import { nav } from '../data/site';
const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---
<header class="hdr">
  <a href="/" class="hdr__logo" aria-label="Anorak Studio, accueil" set:html={logo} />
</header>
<button class="burger" aria-controls="menu" aria-expanded="false" aria-label="Ouvrir le menu">
  <span set:html={menuIcon} />
</button>

<div id="menu" class="menu" hidden>
  <button class="menu__close" aria-label="Fermer le menu">×</button>
  <div class="menu__in">
    <a href="/" class="menu__logo" aria-label="Anorak Studio, accueil" set:html={logoStudio} />
    <hr class="menu__rule" />
    <nav aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <hr class="menu__rule" />
    <Social size={26} class="menu__social" />
  </div>
</div>

<script>
  const hdr = document.querySelector<HTMLElement>('.hdr')!;
  const btn = document.querySelector<HTMLButtonElement>('.burger')!;
  const menu = document.getElementById('menu')!;
  const close = menu.querySelector<HTMLButtonElement>('.menu__close')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? close : btn).focus();
  };
  btn.addEventListener('click', () => setOpen(true));
  close.addEventListener('click', () => setOpen(false));
  menu.addEventListener('click', (e) => { if (e.target === menu || e.target === menu.firstElementChild?.nextElementSibling) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) setOpen(false); });
  // once the page scrolls past the top, give the logo and burger a dark backdrop so they stay readable
  const onScroll = () => {
    const floating = scrollY > 80;
    btn.classList.toggle('is-floating', floating);
    hdr.classList.toggle('is-floating', floating);
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .hdr {
    position: fixed; top: 0; left: 0; right: 0; z-index: 20; height: var(--hdr-h); display: flex; align-items: center;
    padding-inline: var(--gutter); pointer-events: none; transition: background .25s ease;
  }
  .hdr.is-floating { background: linear-gradient(rgba(0, 0, 0, .5), transparent); }
  .hdr__logo { pointer-events: auto; display: block; width: clamp(120px, 12vw, 170px); color: #fff; filter: drop-shadow(0 1px 8px rgba(0, 0, 0, .35)); transition: color .2s; }
  .hdr__logo:hover { color: var(--c-neon); }
  .hdr__logo :global(svg) { width: 100%; height: auto; display: block; }

  .burger {
    position: fixed; top: 10px; right: calc(var(--gutter) - 10px); z-index: 30;
    width: 54px; height: 44px; padding: 10px; border: 0; border-radius: 6px; cursor: pointer;
    background: transparent; color: #fff; transition: color .2s, background .2s;
    filter: drop-shadow(0 1px 6px rgba(0, 0, 0, .35));
  }
  .burger span, .burger :global(svg) { display: block; width: 100%; height: auto; }
  .burger:hover, .burger:focus-visible { color: var(--c-neon); }
  .burger.is-floating { background: rgba(0, 0, 0, .7); filter: none; }

  .menu {
    position: fixed; inset: 0; z-index: 50; background: rgba(0, 0, 0, .7); backdrop-filter: blur(4px);
    display: grid; place-items: center; overflow-y: auto; animation: fade .3s ease;
    height: 100svh;
  }
  .menu[hidden] { display: none; }
  @keyframes fade { from { opacity: 0; } }
  .menu__in {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: clamp(10px, 4svh, 88px); padding: clamp(16px, 5svh, 80px) 24px; min-height: 100%;
    color: #fff; text-align: center;
  }
  .menu__close { position: fixed; top: 8px; right: calc(var(--gutter) - 6px); background: none; border: 0; color: #fff; font-size: 3rem; line-height: 1; cursor: pointer; padding: 4px 12px; transition: color .2s; }
  .menu__close:hover { color: var(--c-neon); }
  .menu__logo { width: clamp(90px, 11vw, 140px); color: #fff; flex: none; }
  .menu__logo:hover { color: var(--c-neon); }
  .menu__logo :global(svg) { width: 100%; height: auto; display: block; }
  .menu__rule { width: min(220px, 60%); border: 0; border-top: 1px solid rgba(255, 255, 255, .35); margin: 0; }
  .menu nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(2px, 1svh, 12px); }
  .menu nav a {
    display: inline-block; text-decoration: none; text-transform: uppercase; letter-spacing: .04em;
    font: 800 clamp(1.4rem, 4.8svh, 2.8rem)/1.08 var(--f-display); transition: color .2s;
  }
  .menu nav a:hover, .menu nav a:focus-visible { color: var(--c-neon); }
  .menu nav a[aria-current] { color: color-mix(in srgb, #fff 55%, transparent); }
  .menu nav a[aria-current]:hover { color: var(--c-neon); }
  .menu :global(.menu__social a:hover) { color: var(--c-neon); background: transparent; }
</style>
