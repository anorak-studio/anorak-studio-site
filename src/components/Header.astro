---
// Like the old site: slim dark bar, ANORAK logo on the left, three-bar icon on the right
// opening a full-screen menu (big uppercase links, logo, social icons).
import logo from '../assets/logos/anorak.svg?raw';
import logoStudio from '../assets/logos/anorak-studio.svg?raw';
import menuIcon from '../assets/logos/menu.svg?raw';
import Social from './Social.astro';
import { nav } from '../data/site';
const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---
<header class="hdr">
  <div class="hdr__in">
    <a href="/" class="hdr__logo" aria-label="Anorak Studio, accueil" set:html={logo} />
    <button class="hdr__burger" aria-controls="menu" aria-expanded="false" aria-label="Ouvrir le menu">
      <span set:html={menuIcon} />
    </button>
  </div>
</header>

<div id="menu" class="menu" hidden>
  <button class="menu__close" aria-label="Fermer le menu">×</button>
  <div class="menu__in">
    <a href="/" class="menu__logo" aria-label="Anorak Studio, accueil" set:html={logoStudio} />
    <nav aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <Social size={24} class="menu__social" />
  </div>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.hdr__burger')!;
  const menu = document.getElementById('menu')!;
  const close = menu.querySelector<HTMLButtonElement>('.menu__close')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? close : btn).focus();
  };
  btn.addEventListener('click', () => setOpen(true));
  close.addEventListener('click', () => setOpen(false));
  menu.addEventListener('click', (e) => { if (e.target === menu) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) setOpen(false); });
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 20; background: var(--c-dark); color: var(--c-on-dark); }
  .hdr__in { height: var(--hdr-h); display: flex; align-items: center; justify-content: space-between; padding-inline: var(--gutter); max-width: 1600px; margin-inline: auto; }
  .hdr__logo { display: block; width: 150px; color: var(--c-on-dark); }
  .hdr__logo :global(svg) { width: 100%; height: auto; display: block; }
  .hdr__burger { background: none; border: 0; padding: 10px; margin-right: -10px; cursor: pointer; color: var(--c-brand-light); }
  .hdr__burger span { display: block; width: 34px; }
  .hdr__burger :global(svg) { display: block; width: 100%; height: auto; }
  .hdr__burger:hover { color: var(--c-on-dark); }

  .menu { position: fixed; inset: 0; z-index: 50; background: color-mix(in srgb, var(--c-dark) 72%, transparent); backdrop-filter: blur(6px); display: flex; justify-content: flex-end; }
  .menu[hidden] { display: none; }
  .menu__in {
    width: min(420px, 100%); height: 100%; overflow-y: auto;
    background: linear-gradient(160deg, var(--c-dark-2) 0%, var(--c-dark) 44%, color-mix(in srgb, var(--c-brand) 60%, var(--c-dark)) 100%);
    color: var(--c-on-dark); padding: 72px 40px 40px; display: flex; flex-direction: column; align-items: center; gap: 40px;
    animation: fade .25s ease;
  }
  @keyframes fade { from { opacity: 0; transform: translateX(24px); } }
  .menu__close { position: absolute; top: 12px; right: calc(var(--gutter) - 6px); z-index: 1; background: none; border: 0; color: var(--c-on-dark); font-size: 2.6rem; line-height: 1; cursor: pointer; padding: 4px 10px; }
  .menu__logo { width: 190px; color: var(--c-on-dark); }
  .menu__logo :global(svg) { width: 100%; height: auto; display: block; }
  .menu nav { width: 100%; }
  .menu nav ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid color-mix(in srgb, var(--c-on-dark) 35%, transparent); }
  .menu nav li { border-bottom: 1px solid color-mix(in srgb, var(--c-on-dark) 35%, transparent); }
  .menu nav a { display: block; text-align: center; padding: 14px 0; text-decoration: none; text-transform: uppercase; letter-spacing: .06em; font: 700 clamp(1.5rem, 5vw, 2rem)/1.1 var(--f-display); transition: color .2s, background .2s; }
  .menu nav a:hover, .menu nav a[aria-current] { color: var(--c-brand-light); }
  .menu :global(.menu__social a:hover) { color: var(--c-brand-light); }
  @media (max-width: 480px) { .hdr__logo { width: 120px; } }
</style>
