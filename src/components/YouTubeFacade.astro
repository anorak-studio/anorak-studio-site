---
// A click-to-load stand-in for a YouTube embed: shows the video's own thumbnail with a play
// button instead of loading the iframe up front. Two reasons to do this rather than embed
// directly:
//   1. A cross-origin iframe (YouTube's own page) can never show our custom cursor — the browser
//      always falls back to the system cursor the moment the pointer is over it. This facade is
//      plain markup on our own page, so our cursor works right up until the click that swaps it
//      for the real player (at which point it's YouTube's page, and there's nothing more we can
//      do about the cursor — same limitation every site with a custom cursor runs into).
//   2. It also means a page with several trailers doesn't load several YouTube iframes (and
//      everything they pull in) before anyone has asked to watch one.
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---
<div class="ytfacade" data-yt-id={id} data-yt-title={title} role="button" tabindex="0" aria-label={`Lire : ${title}`}>
  {/* YouTube's actual uploaded thumbnail, at its full 1280x720 — not the always-available but
      heavily compressed 480x360 hqdefault.jpg, which looked blurry once these boxes got bigger.
      Not every video has one this size, so the script below drops down a size if it doesn't. */}
  <img class="ytfacade__thumb" src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`} data-yt-thumb={id} alt="" loading="lazy" />
  <span class="ytfacade__play" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
  </span>
</div>

<style>
  .ytfacade {
    /* Sits inside a .vrow (see [id].astro), whose own base rule already sets the grab-hand cursor
       across the whole row — this just keeps the facade from being an exception to it. The play
       button below is the one part that reads as clickable. */
    position: absolute; inset: 0; cursor: var(--cursor-grab); background: #000; overflow: hidden;
  }
  /* The thumbnail shows exactly as YouTube serves it — no dark overlay on top — so it never looks
     muddier than the actual custom thumbnail on the video. The play button's own translucent
     circle (below) is what keeps it legible against a bright shot, not a full-image dimming. */
  .ytfacade__thumb { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ytfacade__play {
    position: absolute; top: 50%; left: 50%; translate: -50% -50%;
    width: 56px; height: 56px; border-radius: 50%;
    background: rgba(0, 0, 0, .6); color: #fff; cursor: var(--cursor-point);
    display: flex; align-items: center; justify-content: center;
    transition: background-color .15s, color .15s;
  }
  .ytfacade:hover .ytfacade__play { background: var(--c-neon); color: #000; }
  .ytfacade__play:active { cursor: var(--cursor-click); }
</style>

<script>
  // Runs once for the page: finds every facade still unclicked and wires it up. Astro dedupes
  // this identical inline script across every use of the component, so it's included once no
  // matter how many trailers are on the page.
  // maxresdefault.jpg doesn't exist for every video, but YouTube still serves a 200 response for
  // it either way — a real 404 never happens. When it's missing, what comes back is a small grey
  // 120x90 placeholder, so the only way to tell is to check the image's actual pixel size once it
  // loads, and step down through progressively-safer (but lower-res) thumbnail tiers until one is
  // bigger than that placeholder.
  const THUMB_FALLBACKS = ['sddefault', 'hqdefault'];
  document.querySelectorAll<HTMLImageElement>('.ytfacade__thumb').forEach((img) => {
    const id = img.dataset.ytThumb;
    if (!id) return;
    let step = 0;
    const tryNext = () => {
      if (img.naturalWidth > 120) return; // real thumbnail loaded, nothing to do
      if (step >= THUMB_FALLBACKS.length) return; // hqdefault always exists; stop either way
      img.src = `https://i.ytimg.com/vi/${id}/${THUMB_FALLBACKS[step]}.jpg`;
      step += 1;
    };
    if (img.complete) tryNext();
    else img.addEventListener('load', tryNext);
  });

  document.querySelectorAll<HTMLElement>('.ytfacade').forEach((el) => {
    const play = () => {
      const id = el.dataset.ytId;
      const title = el.dataset.ytTitle || 'Vidéo';
      const iframe = document.createElement('iframe');
      // Set explicitly rather than relying on the page's own `.vrow__item iframe` rule: Astro
      // scopes that rule to elements present at build time, and this iframe is created at
      // runtime, so the scoped selector never matches it — without this it was falling back to
      // the browser's default 300x150 box (tiny, top-left corner) instead of filling its slot.
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?modestbranding=1&rel=0&iv_load_policy=3&playsinline=1&autoplay=1`;
      iframe.title = title;
      iframe.loading = 'eager';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceWith(iframe);
    };
    el.addEventListener('click', play, { once: true });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); play(); }
    }, { once: true });
  });
</script>
